# Registry for the @igrp scope so `npm install @igrp/igrp-studio-nextjs-engine`
# resolves from the iGRP Sonatype registry in consuming projects. NO credentials
# here (committed to Git). Publishing auth lives in .npmrc.local (gitignored) —
# see the "release" script in package.json.
@igrp:registry=https://sonatype.nosi.cv/repository/igrp/

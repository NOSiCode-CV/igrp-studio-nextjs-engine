DATABASE_URL=jdbc:postgresql://${IGRP_ACCESS_MANAGEMENT_DB_HOSTNAME}:5432/${IGRP_ACCESS_MANAGEMENT_DB_NAME}
DATABASE_USERNAME=${IGRP_ACCESS_MANAGEMENT_DB_USER}
DATABASE_PASSWORD=${IGRP_ACCESS_MANAGEMENT_DB_PASSWORD}

SPRING_JPA_HIBERNATE_DDL_AUTO=update
ENABLE_SWAGGER=true
SPRING_PROFILES_ACTIVE=development
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://${IGRP_IAM_HOSTNAME}:8080/realms/igrp

MINIO_URL=http://igrp-minio:9000
MINIO_PORT=9000
MINIO_SECURITY=false
MINIO_ACCESS_KEY=${IGRP_FILE_MANAGEMENT_USER}
MINIO_SECRET_KEY=${IGRP_FILE_MANAGEMENT_PASSWORD}
MINIO_BUCKET_NAME=${IGRP_FILE_MANAGEMENT_STORAGE_NAME}
MINIO_PRESIGNED_URL_EXPIRATION_TIME=10

IGRP_KEYCLOAK_SERVER_URL=https://${IGRP_IAM_HOSTNAME}:8080
IGRP_KEYCLOAK_REALM=${IGRP_IAM_TENANT}
IGRP_KEYCLOAK_CLIENT_ID=access-management
IGRP_KEYCLOAK_CLIENT_SECRET=**********
IGRP_KEYCLOAK_GRANT_TYPE=client_credentials
name: '{{toLowerCase resourceConfig.workspace}}-workspace'

networks:
{{toLowerCase resourceConfig.workspace}}-network:
    driver: bridge

services:
  {{#each resourceConfig.projects}}
  {{#if (eq this.config.type 'springboot')}}

  {{#if (eq this.config.database "Postgresql")}}
  {{> postgres-docker-service resourceConfig=this workspace=../resourceConfig.workspace}}
  {{else if (eq this.config.database "MySQL")}}
  {{> mysql-docker-service resourceConfig=this workspace=../resourceConfig.workspace}}
  {{else if (eq this.config.database "Oracle")}}
  {{> oracle-docker-service resourceConfig=this workspace=../resourceConfig.workspace}}
  {{/if}}

  {{#if this.containerName}}{{this.containerName}}{{else}}{{toLowerCase this.config.apiName}}-service{{/if}}:
    build: ./projects/{{this.basePath}}
    container_name: {{#if this.containerName}}{{this.containerName}}{{else}}{{toLowerCase this.config.apiName}}-service{{/if}}
    depends_on:
    {{#if this.dependsOn}}
    {{#each this.dependsOn}}
      - {{this.service}}
    {{/each}}
      - {{#if (eq this.config.database "Postgresql")}}postgres-{{toLowerCase this.config.apiName}}{{else if (eq this.config.database "MySQL")}}mysql-{{toLowerCase this.config.apiName}}{{else if (eq this.config.database "Oracle")}}oracle-{{toLowerCase this.config.apiName}}{{/if}}
    {{/if}}
    {{#if this.environments}}
    env_file: ".{{toLowerCase this.config.apiName}}.env"
    {{/if}}
    ports:
      - "{{this.ports.external}}:{{this.ports.internal}}"
    networks:
      - {{toLowerCase ../resourceConfig.workspace}}-network
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 700m
    {{#if this.config.enableObservability}}
    labels:
      logging: "promtail"
    {{/if}}

  {{/if~}}
  {{#if (eq this.config.type 'nextjs')}}
  {{#if this.containerName}}{{this.containerName}}{{else}}{{toLowerCase this.config.appName}}-ui{{/if}}:
    build: ./projects/{{this.basePath}}
    container_name: {{#if this.containerName}}{{this.containerName}}{{else}}{{toLowerCase this.config.appName}}-ui{{/if}}
    ports:
      - "{{this.ports.external}}:{{this.ports.internal}}"
    networks:
      - {{toLowerCase ../resourceConfig.workspace}}-network
    {{#if this.dependsOn}}
    depends_on:
    {{#each this.dependsOn}}
      - {{this.service}}
    {{/each}}
    {{/if}}
    {{#if this.environments}}
    env_file: ".{{toLowerCase this.config.appName}}.env"
    {{/if}}
    stdin_open: true

  {{/if~}}

  {{/each}}
  {{> igrp-docker-services resourceConfig=resourceConfig}}

  {{#each resourceConfig.services}}
  {{{render-service this}}}
  {{/each}}

volumes:
  {{#each (extractVolumes resourceConfig)}}
  {{this.name}}:
    driver: {{#if this.driver}}{{this.driver}}{{else}}local{{/if}}
  {{/each}}
  igrp_access_management_data:
    driver: local
  igrp_iam_data:
    driver: local
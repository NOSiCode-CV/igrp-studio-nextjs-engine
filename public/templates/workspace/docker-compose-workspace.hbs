name: '{{toLowerCase resourceConfig.workspace}}-igrp'

networks:
  {{toLowerCase resourceConfig.workspace}}-network:
    driver: bridge

services:
  {{#each resourceConfig.projects}}
  {{#if (eq this.config.type 'springboot')}}

  {{!--{{#if (eq this.config.database "Postgresql")}}
  {{> postgres-docker-service resourceConfig=this workspace=../resourceConfig.workspace}}
  {{else if (eq this.config.database "MySQL")}}
  {{> mysql-docker-service resourceConfig=this workspace=../resourceConfig.workspace}}
  {{else if (eq this.config.database "Oracle")}}
  {{> oracle-docker-service resourceConfig=this workspace=../resourceConfig.workspace}}
  {{/if}}--}}
  {{#if this.containerName}}{{this.containerName}}{{else}}{{normalizeHostname this.config.name}}{{/if}}:
    build: ./projects/{{this.basePath}}
    container_name: {{#if this.containerName}}{{this.containerName}}{{else}}{{normalizeHostname this.config.name}}{{/if}}
    {{#if this.dependsOn}}
    depends_on:
    {{#each this.dependsOn}}
      - {{this.service}}
    {{/each}}
      {{!--- {{#if (eq this.config.database "Postgresql")}}postgres-{{toLowerCase this.config.name}}{{else if (eq this.config.database "MySQL")}}mysql-{{toLowerCase this.config.name}}{{else if (eq this.config.database "Oracle")}}oracle-{{toLowerCase this.config.name}}{{/if}}--}}
    {{/if}}
    {{#if this.environments}}
    env_file: ".{{toLowerCase this.config.name}}.env"
    {{/if}}
    ports:
      - "{{this.ports.external}}:{{this.ports.internal}}"
    networks:
      - {{toLowerCase ../resourceConfig.workspace}}-network
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 700m
    extra_hosts:
      {{toLowerCase ../resourceConfig.workspace}}-igrp: host-gateway
    labels:
      type: "web"
      is_project: true
      uuid: "{{this.config.id}}"
    {{#if this.config.enableObservability}}
      logging: "promtail"
    {{/if}}

  {{/if~}}
  {{#if (eq this.config.type 'nextjs')}}
  {{#if this.containerName}}{{this.containerName}}{{else}}{{normalizeHostname this.config.name}}-ui{{/if}}:
    build: 
      context: ./projects/{{this.basePath}}
      dockerfile: docker/development/Dockerfile
    container_name: {{#if this.containerName}}{{this.containerName}}{{else}}{{normalizeHostname this.config.name}}-ui{{/if}}
    ports:
      - "{{this.ports.external}}:{{this.ports.internal}}"
    networks:
      - {{toLowerCase ../resourceConfig.workspace}}-network
    {{#if this.dependsOn}}
    depends_on:
    {{#each this.dependsOn}}
      - {{this.service}}
    {{/each}}
    {{/if}}
    {{#if this.environments}}
    env_file: ".{{toLowerCase this.config.name}}.env"
    {{/if}}
    extra_hosts:
      {{toLowerCase ../resourceConfig.workspace}}-igrp: host-gateway
    stdin_open: true
    labels:
      type: "web"
      is_project: true
      uuid: "{{this.config.id}}"

  {{/if~}}

  {{/each}}
  {{!--{{> igrp-docker-services resourceConfig=resourceConfig}}--}}

  {{#each resourceConfig.services}}
  {{{render-service this}}}
  {{/each}}

volumes:
  {{#each (extractVolumes resourceConfig basePath registryService)}}
  {{this.name}}:
    driver: {{#if this.driver}}{{this.driver}}{{else}}local{{/if}}
  {{/each}}

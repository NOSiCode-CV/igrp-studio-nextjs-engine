name: '{{ '' | toLowerCase: resourceConfig.workspace }}-igrp'

networks:
  {{ '' | toLowerCase: resourceConfig.workspace }}-network:
    driver: bridge

services:
  {% for this in resourceConfig.projects -%}
  {% if this.config.type == 'springboot' -%}

  {% comment %}{% if this.config.database == "Postgresql" %}
  {% partial 'postgres-docker-service', resourceConfig: this, workspace: resourceConfig.workspace %}
  {{ '' | else: if, '' }}
  {% partial 'mysql-docker-service', resourceConfig: this, workspace: resourceConfig.workspace %}
  {{ '' | else: if, '' }}
  {% partial 'oracle-docker-service', resourceConfig: this, workspace: resourceConfig.workspace %}
  {% endif %}{% endcomment %}
  {% if this.containerName %}{{ this.containerName }}{% else %}{{ '' | normalizeHostname: this.config.name }}{% endif %}:
    build: ./projects/{{ this.basePath }}
    container_name: {% if this.containerName %}{{ this.containerName }}{% else %}{{ '' | normalizeHostname: this.config.name }}{% endif %}
    {% if this.dependsOn -%}
    depends_on:
    {% for this in this.dependsOn -%}
      - {{ this.service }}
    {% endfor -%}
      {% comment %}- {% if this.config.database == "Postgresql" %}postgres-{{ '' | toLowerCase: this.config.name }}{{ '' | else: if, '' }}mysql-{{ '' | toLowerCase: this.config.name }}{{ '' | else: if, '' }}oracle-{{ '' | toLowerCase: this.config.name }}{% endif %}{% endcomment %}
    {% endif -%}
    {% if this.environments -%}
    env_file: ".{{ '' | toLowerCase: this.config.name }}.env"
    {% endif -%}
    ports:
      - "{{ this.ports.external }}:{{ this.ports.internal }}"
    networks:
      - {{ '' | toLowerCase: resourceConfig.workspace }}-network
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 700m
    extra_hosts:
      {{ '' | toLowerCase: resourceConfig.workspace }}-igrp: host-gateway
    labels:
      type: "web"
      is_project: true
      uuid: "{{ this.config.id }}"
    {% if this.config.enableObservability -%}
      logging: "promtail"
    {% endif -%}

  {% endif -%}
  {% if this.config.type == 'nextjs' -%}
  {% if this.containerName %}{{ this.containerName }}{% else %}{{ '' | normalizeHostname: this.config.name }}-ui{% endif %}:
    build: 
      context: ./projects/{{ this.basePath }}
      dockerfile: docker/development/Dockerfile
    container_name: {% if this.containerName %}{{ this.containerName }}{% else %}{{ '' | normalizeHostname: this.config.name }}-ui{% endif %}
    ports:
      - "{{ this.ports.external }}:{{ this.ports.internal }}"
    networks:
      - {{ '' | toLowerCase: resourceConfig.workspace }}-network
    {% if this.dependsOn -%}
    depends_on:
    {% for this in this.dependsOn -%}
      - {{ this.service }}
    {% endfor -%}
    {% endif -%}
    {% if this.environments -%}
    env_file: ".{{ '' | toLowerCase: this.config.name }}.env"
    {% endif -%}
    extra_hosts:
      {{ '' | toLowerCase: resourceConfig.workspace }}-igrp: host-gateway
    stdin_open: true
    labels:
      type: "web"
      is_project: true
      uuid: "{{ this.config.id }}"

  {% endif -%}

  {% endfor -%}
  {% comment %}{% partial 'igrp-docker-services', resourceConfig: resourceConfig %}{% endcomment %}

  {% for this in resourceConfig.services -%}
  {{ '' | render-service: this }}
  {% endfor -%}

volumes:
  {% for this in resourceConfig | extractVolumes: basePath, registryService -%}
  {{ this.name }}:
    driver: {% if this.driver %}{{ this.driver }}{% else %}local{% endif %}
  {% endfor -%}

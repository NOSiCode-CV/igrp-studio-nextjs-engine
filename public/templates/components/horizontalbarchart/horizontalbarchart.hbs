<IGRPHorizontalBarChart
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  bars={
    [
    {{#if resourceConfig.properties.bars}}
      {{#each resourceConfig.properties.bars}}
        {
          dataKey: '{{this.dataKey}}',
          {{#if this.radius}}radius: {{this.radius}},{{/if~}}
        },
      {{/each}}
    {{/if~}}
    ]
  }
  {{#if resourceConfig.properties.customLegend}}
  customLegend={
    <>
    {{{resourceConfig.properties.customLegend}}}
    </>
  }
  {{/if}}
  categoryKey="{{resourceConfig.properties.categoryKey}}"
  {{#if resourceConfig.properties.title}}
  title="{{resourceConfig.properties.title}}"
  {{/if~}}
  {{#if resourceConfig.properties.description}}
  description="{{resourceConfig.properties.description}}"
  {{/if~}}
  {{#if resourceConfig.properties.showGrid}}
  showGrid={ {{resourceConfig.properties.showGrid}} }
  {{/if~}}
  {{#if resourceConfig.properties.showTooltip}}
  showTooltip={ {{resourceConfig.properties.showTooltip}} }
  {{/if~}}
  {{#if resourceConfig.properties.hideAxis}}
  hideAxis={ {{resourceConfig.properties.hideAxis}} }
  {{/if~}}
  {{#if resourceConfig.properties.hideXAxis}}
  hideXAxis={ {{resourceConfig.properties.hideXAxis}} }
  {{/if~}}
  {{#if resourceConfig.properties.hideYAxis}}
  hideYAxis={ {{resourceConfig.properties.hideYAxis}} }
  {{/if~}}
  {{#if resourceConfig.properties.stacked}}
  stacked={ {{resourceConfig.properties.stacked}} }
  {{/if~}}
  {{#if resourceConfig.properties.expanded}}
  expanded={ {{resourceConfig.properties.expanded}} }
  {{/if~}}
  {{#if resourceConfig.properties.height}}
  height={ {{resourceConfig.properties.height}} }
  {{/if~}}
  {{#if resourceConfig.properties.width}}
  width={ {{resourceConfig.properties.width}} }
  {{/if~}}
  {{#if resourceConfig.properties.barRadius}}
  barRadius={ {{resourceConfig.properties.barRadius}} }
  {{/if~}}
  {{#if resourceConfig.properties.barGap}}
  barGap={ {{resourceConfig.properties.barGap}} }
  {{/if~}}
  {{#if resourceConfig.properties.barCategoryGap}}
  barCategoryGap="{{resourceConfig.properties.barCategoryGap}}"
  {{/if~}}
  {{#if resourceConfig.properties.showReferenceZero}}
  showReferenceZero={ {{resourceConfig.properties.showReferenceZero}} }
  {{/if~}}
  {{#if resourceConfig.properties.gridColor}}
  gridColor="{{resourceConfig.properties.gridColor}}"
  {{/if~}}
  {{#if resourceConfig.properties.backgroundColor}}
  backgroundColor="{{resourceConfig.properties.backgroundColor}}"
  {{/if~}}
  {{#if resourceConfig.properties.referenceLineColor}}
  referenceLineColor="{{resourceConfig.properties.referenceLineColor}}"
  {{/if~}}
  {{#if resourceConfig.properties.axisColor}}
  axisColor="{{resourceConfig.properties.axisColor}}"
  {{/if~}}
  {{#if resourceConfig.properties.footer}}
  footer={
    {
      description: "{{resourceConfig.properties.footer.description}}"
    }
  }
  {{/if~}}
  {{#if resourceConfig.properties.legendPosition}}
  legendPosition="{{resourceConfig.properties.legendPosition}}"
  {{/if~}}
  {{#if resourceConfig.properties.size}}
  size="{{resourceConfig.properties.size}}"
  {{/if~}}
  {{#if resourceConfig.properties.valueDomain}}
  valueDomain=[{{resourceConfig.properties.valueDomain.min}}, {{resourceConfig.properties.valueDomain.max}}]
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{!--loading={ {{resourceConfig.id}}Loading }--}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
</IGRPHorizontalBarChart>
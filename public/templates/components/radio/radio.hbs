<IGRPRadioGroup
  name="{{resourceConfig.tag}}"
  {{#if resourceConfig.properties.disabled}}
  disabled
  {{/if~}}
  {{#if resourceConfig.properties.dir}}
  dir="{{resourceConfig.properties.dir}}"
  {{/if~}}
  {{#if resourceConfig.properties.label}}
  label="{{resourceConfig.properties.label}}"
  {{/if~}}
  {{#if resourceConfig.properties.orientation}}
  orientation="{{resourceConfig.properties.orientation}}"
  {{/if~}}
  {{#if resourceConfig.properties.helperText}}
  helperText="{{resourceConfig.properties.helperText}}"
  {{/if~}}
  {{#if resourceConfig.properties.variant}}
  variant="{{resourceConfig.properties.variant}}"
  {{/if~}}
  {{#if resourceConfig.properties.size}}
  size="{{resourceConfig.properties.size}}"
  {{/if~}}
  {{#if resourceConfig.properties.gridSize}}
  gridSize="{{resourceConfig.properties.gridSize}}"
  {{/if~}}
  {{#if resourceConfig.properties.message}}
  message="{{resourceConfig.properties.message}}"
  {{/if~}}
  {{#if resourceConfig.properties.required}}
  required = { {{resourceConfig.properties.required}} }
  {{/if~}}
  {{#if resourceConfig.properties.readOnly}}
  readOnly
  {{/if~}}
  {{#if resourceConfig.properties.labelClassName}}
  labelClassName="{{resourceConfig.properties.labelClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.error}}
  error="{{resourceConfig.properties.error}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
/>
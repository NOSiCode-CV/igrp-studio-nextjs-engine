<IGRPMenuNavigation
  {% if resourceConfig.properties.title and not resourceConfig.data.title -%}
  title={ `{{ resourceConfig.properties.title }}` }
  {% endif -%}
  {% if resourceConfig.properties.badgeContent and not resourceConfig.data.badgeContent -%}
  badgeContent={ `{{ resourceConfig.properties.badgeContent }}` }
  {% endif -%}
  {% if resourceConfig.properties.badgeVariant and not resourceConfig.data.badgeVariant -%}
  badgeVariant={ `{{ resourceConfig.properties.badgeVariant }}` }
  {% endif -%}
  {% if resourceConfig.properties.badgeColor and not resourceConfig.data.badgeColor -%}
  badgeColor={ `{{ resourceConfig.properties.badgeColor }}` }
  {% endif -%}
  {% if resourceConfig.properties.badgeClassName and not resourceConfig.data.badgeClassName -%}
  badgeClassName={ `{{ resourceConfig.properties.badgeClassName }}` }
  {% endif -%}
  {% if resourceConfig.properties.showChevron and not resourceConfig.data.showChevron -%}
  showChevron={ {{ resourceConfig.properties.showChevron }} }
  {% endif -%}
  {% if resourceConfig.properties.isStickyTop and not resourceConfig.data.isStickyTop -%}
  isStickyTop={ {{ resourceConfig.properties.isStickyTop }} }
  {% endif -%}
  {% if resourceConfig.interactions -%}
  {{ '' | render-interactions: resourceConfig.interactions }}
  {% endif -%}
  {% if resourceConfig.data -%}
  {{ '' | render-data: resourceConfig.data, resourceConfig }}
  {% endif -%}
  {% if resourceConfig.properties.commonProperties.customProperties -%}
  {{ '' | render-properties: resourceConfig.properties.commonProperties.customProperties }}
  {% endif -%}
    {% assign componentClassName = resourceConfig.properties.className -%}
  {% assign parentChildClassNames = parentResourceConfig | addClassNameFromChildProperties: registry -%}
  {% if componentClassName or parentChildClassNames or resourceConfig.style -%}
  className={ cn({% if componentClassName -%}'{{ componentClassName }}',{% endif -%}{{ parentChildClassNames }}{{ resourceConfig | addClassNameFromProperties: registry }}{{ resourceConfig.style | addClassNameFromStyle }}) }
  {% endif -%}
  sections={
    [
    {% if resourceConfig.children -%}
      {% for this in resourceConfig.children | extractMenuNavigationItems -%}
        {% if this | checkRules %}{{ '' | resolveArrayElementRules: this }}{% endif %}
        {
          id: "{{ this.properties.targetRef }}",
          {% if this.properties.label -%}
          label: `{{ this.properties.label }}`,
          {% endif -%}
          {% if this.properties.iconProperties.icon -%}
          icon: `{{ this.properties.iconProperties.icon }}`,
          {% endif -%}
          {% if this.properties.disabled and not this.data.disabled -%}
          disabled: {{ this.properties.disabled }}
          {% endif -%}
          {% if not this.properties.disabled and this.data.disabled -%}
          disabled: {{ this.data.disabled.state.name }}
          {% endif -%}
        }{% if this | checkRules %}] : []){% endif %},
      {% endfor -%}
    {% endif -%}
    ]
  }
/>
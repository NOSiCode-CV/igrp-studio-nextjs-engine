<IGRPMenuNavigation
  {{#if resourceConfig.properties.title}}
  title={ "{{resourceConfig.properties.title}}" }
  {{/if~}}
  {{#if resourceConfig.properties.badgeContent}}
  badgeContent={ "{{resourceConfig.properties.badgeContent}}" }
  {{/if~}}
  {{#if resourceConfig.properties.badgeVariant}}
  badgeVariant={ "{{resourceConfig.properties.badgeVariant}}" }
  {{/if~}}
  {{#if resourceConfig.properties.badgeColor}}
  badgeColor={ "{{resourceConfig.properties.badgeColor}}" }
  {{/if~}}
  {{#if resourceConfig.properties.badgeClassName}}
  badgeClassName={ "{{resourceConfig.properties.badgeClassName}}" }
  {{/if~}}
  {{#if resourceConfig.properties.showChevron}}
  showChevron={ {{resourceConfig.properties.showChevron}} }
  {{/if~}}
  {{#if resourceConfig.properties.isStickyTop}}
  isStickyTop={ {{resourceConfig.properties.isStickyTop}} }
  {{/if~}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  sections={
    [
    {{#if resourceConfig.children}}
      {{#each (extractMenuNavigationItems resourceConfig.children)}}
        {
          id: "{{this.properties.targetRef}}",
          {{#if this.properties.label}}
          label: "{{this.properties.label}}",
          {{/if~}}
          {{#if this.properties.iconProperties.icon}}
          icon: "{{this.properties.iconProperties.icon}}",
          {{/if~}}
          {{#if (and this.properties.disabled (not this.data.disabled))}}
          disabled: {{this.properties.disabled}}
          {{/if~}}
          {{#if (and (not this.properties.disabled) this.data.disabled)}}
          disabled: {{this.data.disabled.state.name}}
          {{/if~}}
        },
      {{/each}}
    {{/if~}}
    ]
  }
/>
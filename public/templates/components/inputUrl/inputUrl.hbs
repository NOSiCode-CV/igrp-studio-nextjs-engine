<IGRPInputUrl
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  name={ `{{resourceConfig.tag}}` }
  {{#if (and resourceConfig.properties.disabled (not resourceConfig.data.disabled))}}
  disabled
  {{/if~}}
  {{#if (and resourceConfig.properties.label (not resourceConfig.data.label))}}
  label={ `{{resourceConfig.properties.label}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.floatingLabel (not resourceConfig.data.floatingLabel))}}
  floatingLabel={ {{resourceConfig.properties.floatingLabel}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.helperText (not resourceConfig.data.helperText))}}
  helperText={ `{{resourceConfig.properties.helperText}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.defaultValue (not resourceConfig.data.defaultValue))}}
  defaultValue={ `{{resourceConfig.properties.defaultValue}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.defaultProtocol (not resourceConfig.data.defaultProtocol))}}
  defaultProtocol={ `{{resourceConfig.properties.defaultProtocol}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.minLength (not resourceConfig.data.minLength))}}
  minLength={ {{resourceConfig.properties.minLength }} }
  {{/if~}}
  {{#if (and resourceConfig.properties.maxLength (not resourceConfig.data.maxLength))}}
  maxLength={ {{resourceConfig.properties.maxLength }} }
  {{/if~}}
  {{#if (and resourceConfig.properties.error (not resourceConfig.data.error))}}
  error={ `{{resourceConfig.properties.error}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.protocols (not resourceConfig.data.protocols))}}
  protocols={
    [
    {{#each resourceConfig.properties.protocols}}
      {
        value: '{{this}}',
        label: '{{this}}'
      },
    {{/each~}}
    ]
  }
  {{/if~}}
  {{#if (and resourceConfig.properties.showIcon (not resourceConfig.data.showIcon))}}
  showIcon={ {{resourceConfig.properties.showIcon}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.required (not resourceConfig.data.required))}}
  required={ {{resourceConfig.properties.required}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconName}}
  iconName={ `{{resourceConfig.properties.iconProperties.iconName}}` }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconSize}}
  iconSize={ `{{resourceConfig.properties.iconProperties.iconSize}}` }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconPlacement}}
  iconPlacement={ `{{resourceConfig.properties.iconProperties.iconPlacement}}` }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconClassName}}
  iconClassName={ `{{resourceConfig.properties.iconProperties.iconClassName}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.readOnly (not resourceConfig.data.readOnly))}}
  readOnly
  {{/if~}}
  {{#if (and resourceConfig.properties.autofocus (not resourceConfig.data.autofocus))}}
  autoFocus={ {{resourceConfig.properties.autofocus}} }
  {{/if~}}
  {{#if (or (and resourceConfig.properties.className parentResourceConfig) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.className (not parentResourceConfig)) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties) resourceConfig.style)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
/>
<IGRPSelect
  name="{{resourceConfig.tag}}"
  placeholder="{{resourceConfig.properties.placeholder}}"
  {{#if resourceConfig.properties.disabled}}
  disabled
  {{/if~}}
  {{#if resourceConfig.properties.width}}
  width="{{resourceConfig.properties.width}}"
  {{/if~}}
  {{#if resourceConfig.properties.label}}
  label="{{resourceConfig.properties.label}}"
  {{/if~}}
  {{#if resourceConfig.properties.floatingLabel}}
  floatingLabel={ {{resourceConfig.properties.floatingLabel}} }
  {{/if~}}
  {{#if resourceConfig.properties.required}}
  required = { {{resourceConfig.properties.required}} }
  {{/if~}}
  {{#if resourceConfig.properties.readOnly}}
  readOnly
  {{/if~}}
  {{#if resourceConfig.properties.selectClassName}}
  selectClassName="{{resourceConfig.properties.selectClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.labelClassName}}
  labelClassName="{{resourceConfig.properties.labelClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.selectLabel}}
  selectLabel="{{resourceConfig.properties.selectLabel}}"
  {{/if~}}
  {{#if resourceConfig.properties.errorText}}
  errorText="{{resourceConfig.properties.errorText}}"
  {{/if~}}
  {{#if resourceConfig.properties.showSearch}}
  showSearch = { {{resourceConfig.properties.showSearch}} }
  {{/if~}}
  {{#if resourceConfig.properties.showGroup}}
  showGroup = { {{resourceConfig.properties.showGroup}} }
  {{/if~}}
  {{#if resourceConfig.properties.showStatus}}
  showStatus = { {{resourceConfig.properties.showStatus}} }
  {{/if~}}
  {{#if resourceConfig.properties.showIcon}}
  showIcon = { {{resourceConfig.properties.showIcon}} }
  {{/if~}}
  {{#if resourceConfig.properties.formContext}}
  formContext = { {{resourceConfig.properties.formContext}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconName}}
  iconName="{{resourceConfig.properties.iconProperties.iconName}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className="{{concat (concat resourceConfig.properties.className (addClassNameFromChildProperties parentResourceConfig registry)) (addClassNameFromProperties resourceConfig registry)}}"
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className="{{concat resourceConfig.properties.className (addClassNameFromProperties resourceConfig registry)}}"
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig)}}
  className="{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry)}}"
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
/>
<IGRPButton
  {{#if resourceConfig.properties.type}}
  type="{{resourceConfig.properties.type}}"
  {{/if~}}
  {{#if resourceConfig.properties.variant}}
  variant="{{resourceConfig.properties.variant}}"
  {{/if~}}
  {{#if resourceConfig.properties.size}}
  size="{{resourceConfig.properties.size}}"
  {{/if~}}
  {{!--disabled={ {{resourceConfig.id}}Disabled }--}}
  {{#if resourceConfig.properties.disabled}}
  disabled={ {{resourceConfig.properties.disabled}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.showIcon}}
  showIcon={ {{resourceConfig.properties.iconProperties.showIcon}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconName}}
  iconName="{{resourceConfig.properties.iconProperties.iconName}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconPlacement}}
  iconPlacement="{{resourceConfig.properties.iconProperties.iconPlacement}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconClassName}}
  iconClass="{{resourceConfig.properties.iconClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconSize}}
  iconSize={ {{resourceConfig.properties.iconProperties.iconSize}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className="{{concat resourceConfig.properties.className (addClassNameFromChildProperties parentResourceConfig registry)}}"
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className="{{resourceConfig.properties.className}}"
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig)}}
  className="{{addClassNameFromChildProperties parentResourceConfig registry}}"
  {{/if~}}
  {{/if}}
  {{/if}}
  {{!--loading={ {{resourceConfig.id}}Loading }--}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.properties.customProperties}}
  {{{render-properties resourceConfig.properties.customProperties}}}
  {{/if}}
>
  {{#if resourceConfig.properties.label}}
  {{resourceConfig.properties.label}}
  {{else}}
  {{#if resourceConfig.children}}
  {{#each resourceConfig.children}}
  {{{render-layout this}}}
  {{/each}}
  {{/if~}}
  {{/if~}}
</IGRPButton>

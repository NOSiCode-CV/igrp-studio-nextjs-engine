<Button
  {{#if resourceConfig.properties.variant}}variant="{{resourceConfig.properties.variant}}"{{/if}}
  {{#if resourceConfig.properties.size}}size="{{resourceConfig.properties.size}}"{{/if}}
  {{#if resourceConfig.properties.disabled}}disabled{{/if}}
  {{#if resourceConfig.properties.loading}}disabled{{/if}}
  onClick={() => { {{#if resourceConfig.properties.onClick}}{{resourceConfig.properties.onClick}}(){{else}}handleClick(){{/if}} }}
>
  {{resourceConfig.properties.label}}
</Button>

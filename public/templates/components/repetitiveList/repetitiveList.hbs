<IGRPRepetitiveComponent{{{singleTypeFormatter resourceConfig.dataType}}}
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  keyExtractor={ ({{#if resourceConfig.properties.variable}}{{resourceConfig.properties.variable}}{{else}}item{{/if}}) => {{#if resourceConfig.properties.dataKey}}{{#if resourceConfig.properties.variable}}{{resourceConfig.properties.variable}}{{else}}item{{/if}}.{{resourceConfig.properties.dataKey}}{{else}}''{{/if}} }
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
>
{ ({{#if resourceConfig.properties.variable}}{{resourceConfig.properties.variable}}{{else}}item{{/if}}) =>
  <>
  {{#if resourceConfig.children}}
  {{#each resourceConfig.children}}
  {{{render-layout this ../resourceConfig}}}
  {{/each}}
  {{/if~}}
  </>
}
</IGRPRepetitiveComponent>

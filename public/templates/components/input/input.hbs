<FormField
  control={() => { {{#if resourceConfig.properties.control}}{{resourceConfig.properties.control}}(){{/if}} }}
  name="{{resourceConfig.properties.name}}"
  render={({ field }) => (
    <FormItem>
      <FormLabel>{{resourceConfig.properties.label}}</FormLabel>
      <FormControl>
        <Input
          type="{{resourceConfig.properties.type}}"
          placeholder="{{resourceConfig.properties.placeholder}}"
          value={field.value}
          onChange={field.onChange}
          {{#if resourceConfig.properties.disabled}}disabled{{/if}}
        />
      </FormControl>
      <FormDescription>{{resourceConfig.properties.description}}</FormDescription>
      {{#if resourceConfig.properties.message}}
        <FormMessage>{{resourceConfig.properties.message}}</FormMessage>
      {{/if}}
    </FormItem>
  )}
/>
<IGRPInputBasic
  type="{{resourceConfig.properties.type}}"
  placeholder="{{resourceConfig.properties.placeholder}}"
  value={input{{resourceConfig.id}}Value}
  onChange={(e: any) => { setInput{{resourceConfig.id}}Value(e.target.value) }}
  {{#if resourceConfig.properties.disabled}}
  disabled
  {{/if~}}
  {{#if resourceConfig.properties.labelText}}
  labelText="{{resourceConfig.properties.labelText}}"
  {{/if~}}
  {{#if resourceConfig.properties.floatingLabel}}
  floatingLabel={ {{resourceConfig.properties.floatingLabel}} }
  {{/if~}}
  {{#if resourceConfig.properties.helperText}}
  helperText="{{resourceConfig.properties.helperText}}"
  {{/if~}}
  {{#if resourceConfig.properties.showIcon}}
  showIcon={ {{resourceConfig.properties.showIcon}} }
  {{/if~}}
  {{#if resourceConfig.properties.required}}
  required={ {{resourceConfig.properties.required}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconName}}
  iconName="{{resourceConfig.properties.iconName}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconSize}}
  iconSize="{{resourceConfig.properties.iconSize}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconPlacement}}
  iconPlacement="{{resourceConfig.properties.iconPlacement}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconClassName}}
  iconClassName="{{resourceConfig.properties.iconClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.readOnly}}
  readOnly
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className="{{concat resourceConfig.properties.className (addClassNameFromChildProperties parentResourceConfig registry)}}"
  {{/if}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className="{{resourceConfig.properties.className}}"
  {{/if}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig)}}
  className="{{addClassNameFromChildProperties parentResourceConfig registry}}"
  {{/if~}}
/>
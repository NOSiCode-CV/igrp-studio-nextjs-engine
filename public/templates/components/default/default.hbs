<{{resolveComponent resourceConfig.componentName registry}}
  {{#if resourceConfig.tag}}
  name={ `{{{resourceConfig.tag}}}` }
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  {{#if resourceConfig.properties}}
  {{{render-properties resourceConfig.properties resourceConfig.data (resolveClassNameProperty resourceConfig registry)}}}
  {{/if}}
  {{#if (or (and (getPropertyByKey resourceConfig.properties (resolveClassNameProperty resourceConfig registry)) parentResourceConfig) resourceConfig.style)}}
  {{{resolveClassNameProperty resourceConfig registry}}}={ cn({{{concat "'" (getPropertyByKey resourceConfig.properties (resolveClassNameProperty resourceConfig registry)) "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (getPropertyByKey resourceConfig.properties (resolveClassNameProperty resourceConfig registry)) (not parentResourceConfig)) resourceConfig.style)}}
  {{{resolveClassNameProperty resourceConfig registry}}}={ cn({{{concat "'" (getPropertyByKey resourceConfig.properties (resolveClassNameProperty resourceConfig registry)) "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty (getPropertyByKey resourceConfig.properties (resolveClassNameProperty resourceConfig registry))) parentResourceConfig.childProperties) resourceConfig.style)}}
  {{{resolveClassNameProperty resourceConfig registry}}}={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
  {{#if resourceConfig.content}}
  {{resourceConfig.content}}
  {{else}}
  {{#if (and resourceConfig.properties.content (not resourceConfig.data.content))}}
  {{resourceConfig.properties.content}}
  {{else}}
  {{#if (and (not resourceConfig.properties.content) resourceConfig.data.content)}}
  { {{#if resourceConfig.data.content.value}}{{resourceConfig.data.content.value.code}}{{else}}{{resourceConfig.data.content.state.name}}{{/if}} }
  {{else}}
  {{#if resourceConfig.children}}
  {{#each resourceConfig.children}}
  {{{render-layout this ../resourceConfig}}}
  {{/each}}
  {{/if~}}
  {{/if~}}
  {{/if~}}
  {{/if~}}
</{{resolveComponent resourceConfig.componentName registry}}>
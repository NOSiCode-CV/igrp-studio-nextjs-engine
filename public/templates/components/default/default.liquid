<{{ '' | resolveComponent: resourceConfig.componentName, registry }}
  {% if resourceConfig.tag -%}
  id={ `{{ resourceConfig.tag }}` }
  {% endif -%}
  {% if resourceConfig.properties.commonProperties.generateReference -%}
  ref={ getSectionRef('{{ resourceConfig.tag }}') }
  data-section-id={ '{{ resourceConfig.tag }}' }
  {% endif -%}
  {% assign classNameProperty = '' | resolveClassNameProperty: resourceConfig, registry -%}
  {% assign propertiesSchema = resourceConfig.componentName | resolvePropertiesSchema: registry -%}
  {% if resourceConfig.properties -%}
  {{ '' | render-properties: resourceConfig.properties, resourceConfig.data, classNameProperty, false, propertiesSchema }}
  {% endif -%}
  {% assign parentChildClassNames = parentResourceConfig | addClassNameFromChildProperties: registry -%}
  {% if parentResourceConfig and parentResourceConfig.childProperties and parentResourceConfig.childProperties.className and not parentChildClassNames -%}
  {% assign parentChildClassNames = "'" | append: parentResourceConfig.childProperties.className | append: "'," -%}
  {% endif -%}
  {% assign componentClassName = resourceConfig.properties | getPropertyByKey: classNameProperty -%}
  {% assign propertyClassNames = resourceConfig | addClassNameFromProperties: registry -%}
  {% assign styleClassNames = resourceConfig.style | addClassNameFromStyle -%}
  {% if componentClassName or parentChildClassNames or propertyClassNames or styleClassNames -%}
  {{ classNameProperty }}={ cn({% if componentClassName %}'{{ componentClassName }}',{% endif %}{{ '' | concat: parentChildClassNames, propertyClassNames, styleClassNames }}) }
  {% endif -%}
  {% if resourceConfig.interactions -%}
  {{ '' | render-interactions: resourceConfig.interactions }}
  {% endif -%}
  {% if resourceConfig.data -%}
  {{ '' | render-data: resourceConfig.data, resourceConfig }}
  {% endif -%}
  {% if resourceConfig.properties.commonProperties.customProperties -%}
  {{ '' | render-properties: resourceConfig.properties.commonProperties.customProperties }}
  {% endif -%}
>
  {% if resourceConfig.content -%}
  {{ resourceConfig.content }}
  {% else -%}
  {% if resourceConfig.properties.content and not resourceConfig.data.content -%}
  {{ resourceConfig.properties.content }}
  {% else -%}
  {% if not resourceConfig.properties.content and resourceConfig.data.content -%}
  { {% if resourceConfig.data.content.value %}{{ resourceConfig.data.content.value.code }}{% else %}{{ resourceConfig.data.content.state.name }}{% endif %} }
  {% else -%}
  {% if resourceConfig.children -%}
  {% for child in resourceConfig.children -%}
  {{ '' | render-layout: child, resourceConfig }}
  {% endfor -%}
  {% endif -%}
  {% endif -%}
  {% endif -%}
  {% endif -%}
</{{ '' | resolveComponent: resourceConfig.componentName, registry }}>

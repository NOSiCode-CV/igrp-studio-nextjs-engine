<IGRPPdfViewer
  {{#if resourceConfig.tag}}
  id={ `{{{resourceConfig.tag}}}` }
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  document={
    {
      id: 1,
      title: {{#if resourceConfig.data.title}}{{#if resourceConfig.data.title.state}}{{resourceConfig.data.title.state.name}}{{else}}{{resourceConfig.data.title.value.code}}{{/if}}{{else}}'{{resourceConfig.properties.title}}'{{/if}},
      description: {{#if resourceConfig.data.description}}{{#if resourceConfig.data.description.state}}{{resourceConfig.data.description.state.name}}{{else}}{{resourceConfig.data.description.value.code}}{{/if}}{{else}}'{{resourceConfig.properties.description}}'{{/if}},
      author: {{#if resourceConfig.data.author}}{{#if resourceConfig.data.author.state}}{{resourceConfig.data.author.state.name}}{{else}}{{resourceConfig.data.author.value.code}}{{/if}}{{else}}'{{resourceConfig.properties.author}}'{{/if}},
      date: {{#if resourceConfig.data.date}}{{#if resourceConfig.data.date.state}}{{resourceConfig.data.date.state.name}}{{else}}{{resourceConfig.data.date.value.code}}{{/if}}{{else}}'{{resourceConfig.properties.date}}'{{/if}},
      fileUrl: {{#if resourceConfig.data.fileUrl}}{{#if resourceConfig.data.fileUrl.state}}{{resourceConfig.data.fileUrl.state.name}}{{else}}{{resourceConfig.data.fileUrl.value.code}}{{/if}}{{else}}'{{resourceConfig.properties.fileUrl}}'{{/if}},
    }
  }
  {{#if (and resourceConfig.properties.displayMode (not resourceConfig.data.displayMode))}}
  displayMode={ `{{resourceConfig.properties.displayMode}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.viewerPreference (not resourceConfig.data.viewerPreference))}}
  viewerPreference={ `{{resourceConfig.properties.viewerPreference}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.labelButtonCancel (not resourceConfig.data.labelButtonCancel))}}
  labelButtonCancel={ `{{resourceConfig.properties.labelButtonCancel}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.labelButtonNewTab (not resourceConfig.data.labelButtonNewTab))}}
  labelButtonNewTab={ `{{resourceConfig.properties.labelButtonNewTab}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.inlineHeight (not resourceConfig.data.inlineHeight))}}
  inlineHeight={ `{{resourceConfig.properties.inlineHeight}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.notFoundLabel (not resourceConfig.data.notFoundLabel))}}
  notFoundLabel={ `{{resourceConfig.properties.notFoundLabel}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.loadErrorLabel (not resourceConfig.data.loadErrorLabel))}}
  loadErrorLabel={ `{{resourceConfig.properties.loadErrorLabel}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.loadTimeoutMs (not resourceConfig.data.loadTimeoutMs))}}
  loadTimeoutMs={ `{{resourceConfig.properties.loadTimeoutMs}}` }
  {{/if~}}
  {{#if (or (and resourceConfig.properties.className parentResourceConfig) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.className (not parentResourceConfig)) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties) resourceConfig.style)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
</IGRPPdfViewer>
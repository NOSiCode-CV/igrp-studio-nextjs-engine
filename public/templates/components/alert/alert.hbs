<IGRPAlert
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  {{#if resourceConfig.properties.color}}
  color="{{resourceConfig.properties.color}}"
  {{/if~}}
  {{#if resourceConfig.properties.variant}}
  variant="{{resourceConfig.properties.variant}}"
  {{/if~}}
  {{#if resourceConfig.properties.linkLabel}}
  linkLabel="{{resourceConfig.properties.linkLabel}}"
  {{/if~}}
  {{#if resourceConfig.properties.linkUrl}}
  linkUrl="{{resourceConfig.properties.linkUrl}}"
  {{/if~}}
  {{#if resourceConfig.properties.showLink}}
  showLink={ {{resourceConfig.properties.showLink}} }
  {{/if~}}
  {{#if resourceConfig.properties.textColored}}
  textColored={ {{resourceConfig.properties.textColored}} }
  {{/if~}}
  {{#if resourceConfig.properties.borderColored}}
  borderColored={ {{resourceConfig.properties.borderColored}} }
  {{/if~}}
  {{#if resourceConfig.properties.bgColored}}
  bgColored={ {{resourceConfig.properties.bgColored}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.icon}}
  icon={ "{{{resourceConfig.properties.iconProperties.icon}}}" }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.linkIcon}}
  linkIcon={ "{{{resourceConfig.properties.iconProperties.linkIcon}}}" }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconClassName}}
  iconClassName={ "{{{resourceConfig.properties.iconProperties.iconClassName}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
>
  <>
    {{#if resourceConfig.children}}
    {{#each resourceConfig.children}}
    {{{render-layout this ../resourceConfig}}}
    {{/each}}
    {{/if~}}
  </>
</IGRPAlert>

{{#each resourceConfig.types}}
const {{toCamelCase this.name}} = z.object({
  {{#each this.fields}}
    {{this.name}}: z.{{this.type}}(){{#if @last}}{{else}},{{/if}}
  {{/each}}
})

type {{capitalize this.name}} = typeof {{toCamelCase this.name}};

const init{{capitalize this.name}}: z.infer<{{capitalize this.name}}> = {
  {{#each this.fields}}
    {{this.name}}: {{{resolveStateDefault this.defaultValue this.type}}}{{#if @last}}{{else}},{{/if}}
  {{/each}}
}

{{/each}}
{{#each resourceConfig.types}}
const {{toCamelCase this.name}} = z.object({
  {{#each this.fields}}
    {{this.name}}: {{resolveZodTypes this}}{{#if @last}}{{else}},{{/if}}
  {{/each}}
})

type {{capitalize this.name}}ZodType = typeof {{toCamelCase this.name}};

const init{{capitalize this.name}}: z.infer<{{capitalize this.name}}ZodType> = {
  {{#each this.fields}}
    {{this.name}}: {{{resolveStateDefault this.defaultValue this.type this.isList this.fields}}}{{#if @last}}{{else}},{{/if}}
  {{/each}}
}
{{/each}}
<IGRPForm
  {{#if resourceConfig.dataType}}
  schema={ {{toCamelCase resourceConfig.dataType}} }
  {{/if}}
  {{#if resourceConfig.properties.validationMode}}
  validationMode="{{resourceConfig.properties.validationMode}}"
  {{/if~}}
  {{#if resourceConfig.properties.gridClassName}}
  gridClassName="{{resourceConfig.properties.gridClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.resetAfterSubmit}}
  resetAfterSubmit={ {{resourceConfig.properties.resetAfterSubmit}} }
  {{/if~}}
  {{#if resourceConfig.properties.showAction}}
  showAction={ {{resourceConfig.properties.showAction}} }
  {{/if~}}
  {{#if resourceConfig.properties.submitText}}
  submitText="{{resourceConfig.properties.submitText}}"
  {{/if~}}
  {{#if resourceConfig.properties.submitVariant}}
  submitVariant="{{resourceConfig.properties.submitVariant}}"
  {{/if~}}
  formRef={ form{{resourceConfig.tag}}Ref }
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className="{{concat (concat resourceConfig.properties.className (addClassNameFromChildProperties parentResourceConfig registry)) (addClassNameFromProperties resourceConfig registry)}}"
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className="{{concat resourceConfig.properties.className (addClassNameFromProperties resourceConfig registry)}}"
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig)}}
  className="{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry)}}"
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
  <>
  {{#if resourceConfig.children}}
  {{#each resourceConfig.children}}
  {{{render-layout this}}}
  {{/each}}
  {{/if~}}
  </>
</IGRPForm>
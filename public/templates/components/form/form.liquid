<IGRPForm
  {% if resourceConfig.properties.commonProperties.generateReference -%}
  ref={ getSectionRef('{{ resourceConfig.tag }}') }
  data-section-id={ '{{ resourceConfig.tag }}' }
  {% endif -%}
  {% if resourceConfig.dataType -%}
  schema={ {{ '' | toCamelCase: resourceConfig.dataType }} }
  {% endif -%}
  {% if resourceConfig.properties.validationMode and not resourceConfig.data.validationMode -%}
  validationMode={ `{{ resourceConfig.properties.validationMode }}` }
  {% endif -%}
  {% if resourceConfig.properties.gridClassName and not resourceConfig.data.gridClassName -%}
  gridClassName={ `{{ resourceConfig.properties.gridClassName }}` }
  {% endif -%}
  {% if resourceConfig.properties.resetAfterSubmit and not resourceConfig.data.resetAfterSubmit -%}
  resetAfterSubmit={ {{ resourceConfig.properties.resetAfterSubmit }} }
  {% endif -%}
  {% if resourceConfig.properties.showAction and not resourceConfig.data.showAction -%}
  showAction={ {{ resourceConfig.properties.showAction }} }
  {% endif -%}
  {% if resourceConfig.properties.submitText and not resourceConfig.data.submitText -%}
  submitText={ `{{ resourceConfig.properties.submitText }}` }
  {% endif -%}
  {% if resourceConfig.properties.submitVariant and not resourceConfig.data.submitVariant -%}
  submitVariant={ `{{ resourceConfig.properties.submitVariant }}` }
  {% endif -%}
  formRef={ form{{ resourceConfig.tag }}Ref }
    {% assign componentClassName = resourceConfig.properties.className -%}
  {% assign parentChildClassNames = parentResourceConfig | addClassNameFromChildProperties: registry -%}
  {% if componentClassName or parentChildClassNames or resourceConfig.style -%}
  className={ cn({{ '' | concat: "'", componentClassName, "',", parentChildClassNames, resourceConfig | addClassNameFromProperties: registry, resourceConfig.style | addClassNameFromStyle }}) }
  {% endif -%}
  {% if resourceConfig.interactions -%}
  {{ '' | render-interactions: resourceConfig.interactions }}
  {% endif -%}
  {% if resourceConfig.data -%}
  {{ '' | render-data: resourceConfig.data, resourceConfig }}
  {% endif -%}
  {% if resourceConfig.properties.commonProperties.customProperties -%}
  {{ '' | render-properties: resourceConfig.properties.commonProperties.customProperties }}
  {% endif -%}
>
  <>
  {% if resourceConfig.children -%}
  {% for child in resourceConfig.children -%}
  {{ '' | render-layout: child, resourceConfig }}
  {% endfor -%}
  {% endif -%}
  </>
</IGRPForm>
<IGRPPageHeader
  title="{{resourceConfig.properties.title}}"
  {{#if resourceConfig.properties.description}}
  description="{{resourceConfig.properties.description}}"
  {{/if~}}
  {{#if resourceConfig.properties.variant}}
  variant="{{resourceConfig.properties.variant}}"
  {{/if~}}
  {{#if resourceConfig.properties.className}}
  className="{{resourceConfig.properties.className}}"
  {{/if~}}
  {{#if resourceConfig.properties.headlineClassName}}
  headlineClassName="{{resourceConfig.properties.headlineClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.customProperties}}
  {{{render-properties resourceConfig.properties.customProperties}}}
  {{/if}}
>
  <div className="flex items-center gap-2">
    {{#if resourceConfig.children}}
    {{#each resourceConfig.children}}
    {{{render-layout this}}}
    {{/each}}
    {{/if~}}
  </div>
</IGRPPageHeader>

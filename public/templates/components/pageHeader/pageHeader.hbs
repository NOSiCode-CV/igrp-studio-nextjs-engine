<IGRPPageHeader
  {{#if resourceConfig.tag}}
  id={ `{{{resourceConfig.tag}}}` }
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  {{#if (and resourceConfig.properties.title (not resourceConfig.data.title))}}
  title={ `{{{resourceConfig.properties.title}}}` }
  {{/if}}
  {{#if (and resourceConfig.properties.description (not resourceConfig.data.description))}}
  description={ `{{{resourceConfig.properties.description}}}` }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconBackButton}}
  iconBackButton={ `{{resourceConfig.properties.iconProperties.iconBackButton}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.isSticky (not resourceConfig.data.isSticky))}}
  isSticky={ {{resourceConfig.properties.isSticky}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showBackButton (not resourceConfig.data.showBackButton))}}
  showBackButton={ {{resourceConfig.properties.showBackButton}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.value (not resourceConfig.data.value))}}
  value={ `{{{resourceConfig.properties.value}}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.urlBackButton (not resourceConfig.data.urlBackButton))}}
  urlBackButton={ `{{{resolve-segment-path resourceConfig.properties.urlBackButton resourceConfig.properties.segments}}}{{#if (and resourceConfig.properties.params (not resourceConfig.data.params))}}{{{resolve-query-params resourceConfig.properties.params}}}{{/if}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.variant (not resourceConfig.data.variant))}}
  variant={ `{{resourceConfig.properties.variant}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonVariant (not resourceConfig.data.backButtonVariant))}}
  backButtonVariant={ `{{resourceConfig.properties.backButtonVariant}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonSize (not resourceConfig.data.backButtonSize))}}
  backButtonSize={ `{{resourceConfig.properties.backButtonSize}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonAriaLabel (not resourceConfig.data.backButtonAriaLabel))}}
  backButtonAriaLabel={ `{{resourceConfig.properties.backButtonAriaLabel}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonShowText (not resourceConfig.data.backButtonShowText))}}
  backButtonShowText={ {{resourceConfig.properties.backButtonShowText}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonText (not resourceConfig.data.backButtonText))}}
  backButtonText={ `{{resourceConfig.properties.backButtonText}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonClassName (not resourceConfig.data.backButtonClassName))}}
  backButtonClassName={ `{{resourceConfig.properties.backButtonClassName}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backButtonUseBrowserBack (not resourceConfig.data.backButtonUseBrowserBack))}}
  backButtonUseBrowserBack={ {{resourceConfig.properties.backButtonUseBrowserBack}} }
  {{/if~}}
  {{#if (or (and resourceConfig.properties.className parentResourceConfig) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.className (not parentResourceConfig)) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties) resourceConfig.style)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if (and resourceConfig.properties.headlineClassName (not resourceConfig.data.headlineClassName))}}
  headlineClassName={ `{{resourceConfig.properties.headlineClassName}}` }
  {{/if~}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
>
  <div className="flex items-center gap-2">
    {{#if resourceConfig.children}}
    {{#each resourceConfig.children}}
    {{{render-layout this ../resourceConfig}}}
    {{/each}}
    {{/if~}}
  </div>
</IGRPPageHeader>

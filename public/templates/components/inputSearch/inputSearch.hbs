<IGRPInputSearch
  {{#if resourceConfig.tag}}
  name="{{resourceConfig.tag}}"
  {{/if~}}
  placeholder="{{resourceConfig.properties.placeholder}}"
  {{#if resourceConfig.properties.disabled}}
  disabled
  {{/if~}}
  {{#if resourceConfig.properties.label}}
  label="{{resourceConfig.properties.label}}"
  {{/if~}}
  {{#if resourceConfig.properties.submitButtonLabel}}
  submitButtonLabel="{{resourceConfig.properties.submitButtonLabel}}"
  {{/if~}}
  {{#if resourceConfig.properties.submitButtonClassName}}
  submitButtonClassName="{{resourceConfig.properties.submitButtonClassName}}"
  {{/if~}}
  {{#if resourceConfig.properties.floatingLabel}}
  floatingLabel={ {{resourceConfig.properties.floatingLabel}} }
  {{/if~}}
  {{#if resourceConfig.properties.helperText}}
  helperText="{{resourceConfig.properties.helperText}}"
  {{/if~}}
  {{#if (eq resourceConfig.properties.showSubmitButton false)}}
  showSubmitButton={ {{resourceConfig.properties.showSubmitButton}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.showStartIcon}}
  showStartIcon={ {{resourceConfig.properties.iconProperties.showStartIcon}} }
  {{/if~}}
  {{#if resourceConfig.properties.required}}
  required={ {{resourceConfig.properties.required}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.startIcon}}
  startIcon="{{resourceConfig.properties.iconProperties.startIcon}}"
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.submitIcon}}
  submitIcon="{{resourceConfig.properties.iconProperties.submitIcon}}"
  {{/if~}}
  {{#if resourceConfig.properties.readOnly}}
  readOnly
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className="{{concat resourceConfig.properties.className (addClassNameFromChildProperties parentResourceConfig registry)}}"
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className="{{resourceConfig.properties.className}}"
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig)}}
  className="{{addClassNameFromChildProperties parentResourceConfig registry}}"
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
/>
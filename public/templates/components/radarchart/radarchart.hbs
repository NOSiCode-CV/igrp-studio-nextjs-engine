<IGRPRadarChart
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  categoryKey={ `{{resourceConfig.properties.categoryKey}}` }
  angleAxisKey={ `{{resourceConfig.properties.angleAxisKey}}` }
  {{#if (and resourceConfig.properties.title (not resourceConfig.data.title))}}
  title={ `{{resourceConfig.properties.title}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.description (not resourceConfig.data.description))}}
  description={ `{{resourceConfig.properties.description}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.showGrid (not resourceConfig.data.showGrid))}}
  showGrid={ {{resourceConfig.properties.showGrid}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showTooltip (not resourceConfig.data.showTooltip))}}
  showTooltip={ {{resourceConfig.properties.showTooltip}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.hideAxis (not resourceConfig.data.hideAxis))}}
  hideAxis={ {{resourceConfig.properties.hideAxis}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.hideXAxis (not resourceConfig.data.hideXAxis))}}
  hideXAxis={ {{resourceConfig.properties.hideXAxis}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.hideYAxis (not resourceConfig.data.hideYAxis))}}
  hideYAxis={ {{resourceConfig.properties.hideYAxis}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.stacked (not resourceConfig.data.stacked))}}
  stacked={ {{resourceConfig.properties.stacked}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.expanded (not resourceConfig.data.expanded))}}
  expanded={ {{resourceConfig.properties.expanded}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.height (not resourceConfig.data.height))}}
  height={ {{resourceConfig.properties.height}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.width (not resourceConfig.data.width))}}
  width={ {{resourceConfig.properties.width}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showReferenceZero (not resourceConfig.data.showReferenceZero))}}
  showReferenceZero={ {{resourceConfig.properties.showReferenceZero}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.gridColor (not resourceConfig.data.gridColor))}}
  gridColor={ `{{resourceConfig.properties.gridColor}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.backgroundColor (not resourceConfig.data.backgroundColor))}}
  backgroundColor={ `{{resourceConfig.properties.backgroundColor}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.axisColor (not resourceConfig.data.axisColor))}}
  axisColor={ `{{resourceConfig.properties.axisColor}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.footer (not resourceConfig.data.footer))}}
  footer={
    {
      description: `{{resourceConfig.properties.footer.description}}`
    }
  }
  {{/if~}}
  {{#if (and resourceConfig.properties.polarGridType (not resourceConfig.data.polarGridType))}}
  polarGridType={ `{{resourceConfig.properties.polarGridType}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.polarGridLineType (not resourceConfig.data.polarGridLineType))}}
  polarGridLineType={ `{{resourceConfig.properties.polarGridLineType}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.showPolarGrid (not resourceConfig.data.showPolarGrid))}}
  showPolarGrid={ {{resourceConfig.properties.showPolarGrid}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showRadiusAxis (not resourceConfig.data.showRadiusAxis))}}
  showRadiusAxis={ {{resourceConfig.properties.showRadiusAxis}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.radiusAxisDomain (not resourceConfig.data.radiusAxisDomain))}}
  radiusAxisDomain=[{{resourceConfig.properties.radiusAxisDomain.min}}, {{resourceConfig.properties.radiusAxisDomain.max}}]
  {{/if~}}
  {{#if (and resourceConfig.properties.radiusAxisAngle (not resourceConfig.data.radiusAxisAngle))}}
  radiusAxisAngle={ {{resourceConfig.properties.radiusAxisAngle}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.customAngleAsisTick (not resourceConfig.data.customAngleAsisTick))}}
  customAngleAsisTick={ {{{json resourceConfig.properties.customAngleAsisTick}}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showGridLines (not resourceConfig.data.showGridLines))}}
  showGridLines={ {{resourceConfig.properties.showGridLines}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showRadiusLines (not resourceConfig.data.showRadiusLines))}}
  showRadiusLines={ {{resourceConfig.properties.showRadiusLines}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.gridFilled (not resourceConfig.data.gridFilled))}}
  gridFilled={ {{resourceConfig.properties.gridFilled}} }
  {{/if~}}
  {{#if (or (and resourceConfig.properties.className parentResourceConfig) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.className (not parentResourceConfig)) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties) resourceConfig.style)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{!--loading={ {{resourceConfig.id}}Loading }--}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
</IGRPRadarChart>
<div class="chart-container">
  <ResponsiveContainer width="100%" height={resourceConfig.properties.height || 300}>
    <LineChart data={resourceConfig.properties.data}>
      <XAxis dataKey="{{resourceConfig.properties.xAxisKey}}" />
      <YAxis />
      <Tooltip />
      <Legend />
      {{#each resourceConfig.properties.series}}
        <Line type="monotone" dataKey="{{this.key}}" stroke="{{this.color}}" />
      {{/each}}
    </LineChart>
  </ResponsiveContainer>
</div>
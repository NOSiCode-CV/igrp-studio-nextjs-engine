<IGRPFormList
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  {{#if resourceConfig.id}}
  id={ "{{{resourceConfig.id}}}" }
  {{/if~}}
  {{#if resourceConfig.tag}}
  name={ `{{{resourceConfig.tag}}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.label (not resourceConfig.data.label))}}
  label={ "{{{resourceConfig.properties.label}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.description (not resourceConfig.data.description))}}
  description={ "{{{resourceConfig.properties.description}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.color (not resourceConfig.data.color))}}
  color={ "{{{resourceConfig.properties.color}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.variant (not resourceConfig.data.variant))}}
  variant={ "{{{resourceConfig.properties.variant}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.addButtonLabel (not resourceConfig.data.addButtonLabel))}}
  addButtonLabel={ "{{{resourceConfig.properties.addButtonLabel}}}" }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconName}}
  iconName={ "{{{resourceConfig.properties.iconProperties.iconName}}}" }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.addButtonIconName}}
  addButtonIconName={ "{{{resourceConfig.properties.iconProperties.addButtonIconName}}}" }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.addButtonLabel}}
  addButtonLabel={ "{{{resourceConfig.properties.iconProperties.addButtonLabel}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.dot (not resourceConfig.data.dot))}}
  dot={ {{{resourceConfig.properties.dot}}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconClassName}}
  iconClassName={ "{{{resourceConfig.properties.iconProperties.iconClassName}}}" }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconSize}}
  iconSize={ "{{{resourceConfig.properties.iconProperties.iconSize}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.badgeValue (not resourceConfig.data.badgeValue))}}
  badgeValue={ `{{{resourceConfig.properties.badgeValue}}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.badgeClassName (not resourceConfig.data.badgeClassName))}}
  badgeClassName={ "{{{resourceConfig.properties.badgeClassName}}}" }
  {{/if~}}
  {{#if (and resourceConfig.properties.labelClassName (not resourceConfig.data.labelClassName))}}
  labelClassName={ "{{{resourceConfig.properties.labelClassName}}}" }
  {{/if~}}
  renderItem={ (_: {{#if resourceConfig.dataType}}typeof init{{capitalize resourceConfig.dataType}}['{{{resourceConfig.tag}}}'][0]{{else}}any{{/if}}, index: number) => (
      <>
        {{#if resourceConfig.children}}
        {{#each resourceConfig.children}}
        {{{render-layout (indexedTag this ../resourceConfig.tag) ../resourceConfig}}}
        {{/each}}
        {{/if~}}
      </>
    )
  }
  {{#if (and resourceConfig.properties.computeLabel (not resourceConfig.data.computeLabel))}}
  computeLabel={
    (item: {{#if resourceConfig.dataType}}(typeof init{{capitalize resourceConfig.dataType}})['{{{resourceConfig.tag}}}'][0]{{else}}any{{/if}}, index: number) => `{{{resourceConfig.properties.computeLabel.code}}}`
  }
  {{/if~}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
</IGRPFormList>

<FormField
  control={{resourceConfig.properties.control}}
  name="{{resourceConfig.properties.name}}"
  render={({ field }) => (
    <FormItem>
      <FormLabel>{{resourceConfig.properties.label}}</FormLabel>
      <FormControl>
        <Tabs defaultValue="tab1">
          <TabsList>
            {{#each resourceConfig.properties.tabs as |tab|}}
              <TabsTrigger value="{{tab.value}}">
                {{tab.label}}
              </TabsTrigger>
            {{/each}}
          </TabsList>
          <TabsContent value="tab1">
            <TabsPanel>
              {{#if resourceConfig.properties.tab1Content}}
                <p>{{resourceConfig.properties.tab1Content}}</p>
              {{/if}}
            </TabsPanel>
          </TabsContent>
          <TabsContent value="tab2">
            <TabsPanel>
              {{#if resourceConfig.properties.tab2Content}}
                <p>{{resourceConfig.properties.tab2Content}}</p>
              {{/if}}
            </TabsPanel>
          </TabsContent>
        </Tabs>
      </FormControl>
      <FormDescription>{{resourceConfig.properties.description}}</FormDescription>
      {{#if resourceConfig.properties.message}}
      <FormMessage>{{resourceConfig.properties.message}}</FormMessage>
      {{/if}}
    </FormItem>
  )}
/>
<IGRPTabs
  {{#if resourceConfig.properties.commonProperties.generateReference}}
  ref={ getSectionRef('{{resourceConfig.tag}}') }
  data-section-id={ '{{resourceConfig.tag}}' }
  {{/if}}
  {{#if (and resourceConfig.properties.variant (not resourceConfig.data.variant))}}
  variant={ `{{resourceConfig.properties.variant}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.tabTriggerClassName (not resourceConfig.data.tabTriggerClassName))}}
  tabTriggerClassName={ `{{{resourceConfig.properties.tabTriggerClassName}}}` }
  {{/if~}}
  {{#if (and resourceConfig.properties.tabContentClassName (not resourceConfig.data.tabContentClassName))}}
  tabContentClassName={ `{{{resourceConfig.properties.tabContentClassName}}}` }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.showIcon}}
  showIcon={ {{resourceConfig.properties.iconProperties.showIcon}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconPlacement}}
  iconPlacement={ `{{resourceConfig.properties.iconProperties.iconPlacement}}` }
  {{/if~}}
  {{#if (or (and resourceConfig.properties.tabListClassName parentResourceConfig) resourceConfig.style)}}
  tabListClassName={ cn({{{concat "'" resourceConfig.properties.tabListClassName "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.tabListClassName (not parentResourceConfig)) resourceConfig.style)}}
  tabListClassName={ cn({{{concat "'" resourceConfig.properties.tabListClassName "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.tabListClassName) parentResourceConfig.childProperties) resourceConfig.style)}}
  tabListClassName={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  items={
    [
    {{#if resourceConfig.children}}
      {{#each (extractTabsItem resourceConfig.children)}}
        {{#if (checkRules this)}}{{{resolveArrayElementRules this}}}{{/if}}
        {
          {{#if this.properties.value}}
          value: `{{{this.properties.value}}}`,
          {{/if~}}
          {{#if this.properties.label}}
          label: `{{{this.properties.label}}}`,
          {{/if~}}
          {{#if this.properties.iconProperties.icon}}
          icon: `{{{this.properties.iconProperties.icon}}}`,
          {{/if~}}
          {{#if this.properties.className}}
          className: `{{{this.properties.className}}}`,
          {{/if~}}
          {{#if (and this.properties.disabled (not this.data.disabled))}}
          disabled: {{this.properties.disabled}},
          {{/if~}}
          {{#if (and (not this.properties.disabled) this.data.disabled)}}
          disabled: {{{this.data.disabled.state.name}}},
          {{/if~}}
          content: (<>
            {{#if (gt (length this.children) 0)}}
            {{#each this.children}}
            {{{render-layout this ../resourceConfig}}}
            {{/each}}
            {{/if~}}
          </>),
        }{{#if (checkRules this)}}] : []){{/if}}
      {{/each}}
    {{/if~}}
    ]
  }
/>
<IGRPDataTable{{{typeResolution (resolveFirstType resourceConfig.properties.data) 'any'}}}
  data={ contentTable{{resourceConfig.id}} }
  {{#if resourceConfig.properties.showFilter}}showFilter={ {{resourceConfig.properties.showFilter}} }{{/if}}
  {{#if resourceConfig.properties.showPagination}}showPagination={ {{resourceConfig.properties.showFilter}} }{{/if}}
  {{#if resourceConfig.properties.showToggleColumn}}showToggleColumn={ {{resourceConfig.properties.showToggleColumn}} }{{/if}}
  columns={
    [
    {{#if resourceConfig.children}}
      {{#each (extractTableColumns resourceConfig.children)}}
        {{#each this.children}}
        {
          {{#if this.properties.headerTitle}}header: {{> tableHeader this ~}},{{/if~}}
          {{#if this.properties.headerTitle}}accessorKey{{else}}id{{/if}}: '{{toCamelCase this.id}}',
          {{#if (eq this.componentName 'tableActionListCell')}}enableHiding: false,{{/if}}
          cell: ({ row }) => {
          {{{render-table-row this ../../registry}}}
          },
        filterFn: {{#if (eq this.componentName 'tableDateCell')}}dateRangeFilterFn{{else}}facetedFilterFn{{/if}}
        },
        {{/each}}
      {{/each}}
    {{/if~}}
    ]
  }
  filters={
    [
    {{#if resourceConfig.children}}
      {{#each (extractTableFilters resourceConfig.children)}}
        {{#each this.children}}
        {
          {{#if this.id}}columnId: "{{this.id}}",{{/if}}
          component: (column) => (
          {{{render-table-row this ../../registry}}}
          )
        },
        {{/each}}
      {{/each}}
    {{/if~}}
    ]
  }
/>
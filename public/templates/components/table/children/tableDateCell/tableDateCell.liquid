{% assign dateOptionsLiteral = resourceConfig.properties.dateOptions | renderJSXObjectLiteral -%}
return <IGRPDataTableCellDate
  date={ {% if resourceConfig.data.value.code -%}{{ resourceConfig.data.value.code }}{%- elsif resourceConfig.data.value.state.name -%}{{ resourceConfig.data.value.state.name }}{%- else -%}row.getValue('{{ resourceConfig.tag }}'){%- endif %} }
  {% if resourceConfig.properties.language and not resourceConfig.data.language -%}
  language={ `{{ resourceConfig.properties.language }}` }
  {% endif -%}
  {% if dateOptionsLiteral != '' and not resourceConfig.data.dateOptions -%}
  dateOptions={ {{ dateOptionsLiteral }} }
  {% endif -%}
  {% if resourceConfig.data -%}
  {{ '' | render-data: resourceConfig.data, resourceConfig, 'value' }}
  {% endif -%}
>
</IGRPDataTableCellDate>

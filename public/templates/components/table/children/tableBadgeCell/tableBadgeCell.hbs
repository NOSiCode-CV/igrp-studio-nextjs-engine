const rowData = row.original;

{{#if resourceConfig.interactions.customize.function.fnName}}
const { iconName, bgClass, textClass, label, className } = {{resourceConfig.interactions.customize.function.fnName}}(rowData);
{{/if}}

return <IGRPDataTableCellBadge
  {{!--field={ row.getValue('{{resourceConfig.tag}}') }--}}
  label={ {{#if resourceConfig.data.label.value.code}}{{{resourceConfig.data.label.value.code}}}{{else}}{{#if resourceConfig.interactions.customize.function.fnName}}label ?? {{/if}}row.original.{{resourceConfig.tag}}{{/if}} }

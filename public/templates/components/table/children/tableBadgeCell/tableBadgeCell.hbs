  variant={ `{{resourceConfig.properties.variant}}` }
  {{/if~}}
  badgeClassName={ {{#if resourceConfig.interactions.customize.function.fnName}}`${bgClass} ${textClass} ${className}`{{else}}`{{resourceConfig.properties.className}}`{{/if}} }
>

</IGRPDataTableCellBadge>
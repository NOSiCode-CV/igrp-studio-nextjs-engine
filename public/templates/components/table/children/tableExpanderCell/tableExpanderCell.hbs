return <IGRPDataTableCellExpander
  row={ row }
  field={ {{#if resourceConfig.data.value.code}}{{{resourceConfig.data.value.code}}}{{else}}row.getValue('{{resourceConfig.tag}}'){{/if}} }
  {{#if (and resourceConfig.properties.icons (not resourceConfig.data.icons))}}icons={ [ {{resourceConfig.properties.icons}} ] }{{/if~}}
>
  {{#if resourceConfig.children}}
  {{#each resourceConfig.children}}
  {{{render-layout this ../resourceConfig}}}
  {{/each}}
  {{/if~}}
</IGRPDataTableCellExpander>
return <IGRPDataTableCellExpander
  row={ row }
  field={ {% if resourceConfig.data.value.code %}{{ resourceConfig.data.value.code }}{% else %}row.getValue('{{ resourceConfig.tag }}'){% endif %} }
  {% if resourceConfig.properties.icons and not resourceConfig.data.icons %}icons={ [ {{ resourceConfig.properties.icons }} ] }{% endif %}
>
  {% if resourceConfig.children %}
  {% for this in resourceConfig.children %}
  {{ '' | render-layout: this, resourceConfig }}
  {% endfor %}
  {% endif %}
</IGRPDataTableCellExpander>
  {% if resourceConfig.properties.showConfirm and not resourceConfig.data.showConfirm -%}
  showConfirm={ {{ resourceConfig.properties.showCancel }} }
  {% endif -%}
  {% if resourceConfig.properties.classNameCancel and not resourceConfig.data.classNameCancel -%}
  classNameCancel={ `{{ resourceConfig.properties.classNameCancel }}` }
  {% endif -%}
  {% if resourceConfig.properties.classNameConfirm and not resourceConfig.data.classNameConfirm -%}
  classNameConfirm={ `{{ resourceConfig.properties.classNameConfirm }}` }
  {% endif -%}
  {% if resourceConfig.properties.classNameTrigger and not resourceConfig.data.classNameTrigger -%}
  classNameTrigger={ `{{ resourceConfig.properties.classNameTrigger }}` }
  {% endif -%}
  {% if resourceConfig.properties.modalSize and not resourceConfig.data.modalSize -%}
  modalSize={ `{{ resourceConfig.properties.modalSize }}` }
  {% endif -%}
  {% if resourceConfig.properties.modalTitle and not resourceConfig.data.modalTitle -%}
  modalTitle={ `{{ resourceConfig.properties.modalTitle }}` }
  {% endif -%}
  {% if resourceConfig.properties.showStickyFooter and not resourceConfig.data.showStickyFooter -%}
  showStickyFooter={ {{ resourceConfig.properties.showStickyFooter }} }
  {% endif -%}
  {% if resourceConfig.properties.iconProperties.iconClassName -%}
  iconClassName={ `{{ resourceConfig.properties.iconProperties.iconClassName }}` }
  {% endif -%}
    {% assign componentClassName = resourceConfig.properties.className -%}
  {% assign parentChildClassNames = parentResourceConfig | addClassNameFromChildProperties: registry -%}
  {% if componentClassName or parentChildClassNames or resourceConfig.style -%}
  className={ cn({{ '' | concat: "'", componentClassName, "',", parentChildClassNames, resourceConfig | addClassNameFromProperties: registry, resourceConfig.style | addClassNameFromStyle }}) }
  {% endif -%}
  {% comment %}loading={ {{ resourceConfig.tag }}Loading }{% endcomment %}
  {% if resourceConfig.interactions -%}
  {{ '' | render-interactions: resourceConfig.interactions }}
  {% endif -%}
  {% if resourceConfig.properties.commonProperties.customProperties -%}
  {{ '' | render-properties: resourceConfig.properties.commonProperties.customProperties }}
  {% endif -%}
>
  {% if resourceConfig.content -%}
  {{ resourceConfig.content }}
  {% else -%}
  {% if resourceConfig.properties.content and not resourceConfig.data.content -%}
  {{ resourceConfig.properties.content }}
  {% else -%}
  {% if not resourceConfig.properties.content and resourceConfig.data.content -%}
  { {% if resourceConfig.data.content.value %}{{ resourceConfig.data.content.value.code }}{% else %}{{ resourceConfig.data.content.state.name }}{% endif %} }
  {% else -%}
  {% if resourceConfig.children -%}
  {% for child in resourceConfig.children -%}
  {{ '' | render-layout: child, resourceConfig }}
  {% endfor -%}
  {% endif -%}
  {% endif -%}
  {% endif -%}
  {% endif -%}
</IGRPDataTableButtonModal>
<IGRPDataTableButtonModal
  {% if resourceConfig.properties.title and not resourceConfig.data.title -%}
  modalTitle={ `{{ resourceConfig.properties.title }}` }
  {% endif -%}
  {% if resourceConfig.properties.labelTrigger and not resourceConfig.data.labelTrigger -%}
  labelTrigger={ `{{ resourceConfig.properties.labelTrigger }}` }
  {% endif -%}
  {% if resourceConfig.properties.variant and not resourceConfig.data.variant -%}
  variant={ `{{ resourceConfig.properties.variant }}` }
  {% endif -%}
  {% if resourceConfig.properties.disabled and not resourceConfig.data.disabled -%}
  disabled={ {{ resourceConfig.properties.disabled }} }
  {% endif -%}
  {% if resourceConfig.properties.iconProperties.iconName -%}
  icon={ `{{ resourceConfig.properties.iconProperties.iconName }}` }
  {% endif -%}
  {% if resourceConfig.properties.variantCancel and not resourceConfig.data.variantCancel -%}
  variantCancel={ `{{ resourceConfig.properties.variantCancel }}` }
  {% endif -%}
  {% if resourceConfig.properties.variantConfirm and not resourceConfig.data.variantConfirm -%}
  variantConfirm={ `{{ resourceConfig.properties.variantConfirm }}` }
  {% endif -%}
  {% if resourceConfig.properties.labelCancel and not resourceConfig.data.labelCancel -%}
  labelCancel={ `{{ resourceConfig.properties.labelCancel }}` }
  {% endif -%}
  {% if resourceConfig.properties.labelConfirm and not resourceConfig.data.labelConfirm -%}
  labelConfirm={ `{{ resourceConfig.properties.labelConfirm }}` }
  {% endif -%}
  {% if resourceConfig.properties.showCancel and not resourceConfig.data.showCancel -%}

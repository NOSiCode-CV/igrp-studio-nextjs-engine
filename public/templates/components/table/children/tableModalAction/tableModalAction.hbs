<IGRPDataTableButtonModal
  {{#if (and resourceConfig.properties.title (not resourceConfig.data.title))}}
  modalTitle="{{resourceConfig.properties.title}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.labelTrigger (not resourceConfig.data.labelTrigger))}}
  labelTrigger="{{resourceConfig.properties.labelTrigger}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.variant (not resourceConfig.data.variant))}}
  variant="{{resourceConfig.properties.variant}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.disabled (not resourceConfig.data.disabled))}}
  disabled={ {{resourceConfig.properties.disabled}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconName}}
  icon="{{resourceConfig.properties.iconProperties.iconName}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.variantCancel (not resourceConfig.data.variantCancel))}}
  variantCancel="{{resourceConfig.properties.variantCancel}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.variantConfirm (not resourceConfig.data.variantConfirm))}}
  variantConfirm="{{resourceConfig.properties.variantConfirm}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.labelCancel (not resourceConfig.data.labelCancel))}}
  labelCancel="{{resourceConfig.properties.labelCancel}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.labelConfirm (not resourceConfig.data.labelConfirm))}}
  labelConfirm="{{resourceConfig.properties.labelConfirm}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.showCancel (not resourceConfig.data.showCancel))}}
  showCancel={ {{resourceConfig.properties.showCancel}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.showConfirm (not resourceConfig.data.showConfirm))}}
  showConfirm={ {{resourceConfig.properties.showCancel}} }
  {{/if~}}
  {{#if (and resourceConfig.properties.classNameCancel (not resourceConfig.data.classNameCancel))}}
  classNameCancel="{{resourceConfig.properties.classNameCancel}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.classNameConfirm (not resourceConfig.data.classNameConfirm))}}
  classNameConfirm="{{resourceConfig.properties.classNameConfirm}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.classNameTrigger (not resourceConfig.data.classNameTrigger))}}
  classNameTrigger="{{resourceConfig.properties.classNameTrigger}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.modalSize (not resourceConfig.data.modalSize))}}
  modalSize="{{resourceConfig.properties.modalSize}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.modalTitle (not resourceConfig.data.modalTitle))}}
  modalTitle="{{resourceConfig.properties.modalTitle}}"
  {{/if~}}
  {{#if (and resourceConfig.properties.showStickyFooter (not resourceConfig.data.showStickyFooter))}}
  showStickyFooter={ {{resourceConfig.properties.showStickyFooter}} }
  {{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconClassName}}
  iconClassName="{{resourceConfig.properties.iconProperties.iconClassName}}"
  {{/if~}}
  {{#if (or (and resourceConfig.properties.className parentResourceConfig) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.className (not parentResourceConfig)) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties) resourceConfig.style)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
  {{!--loading={ {{resourceConfig.tag}}Loading }--}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.properties.commonProperties.customProperties}}
  {{{render-properties resourceConfig.properties.commonProperties.customProperties}}}
  {{/if}}
>
</IGRPDataTableButtonModal>
<IGRPDataTableFilterFaceted
  column={column}
  placeholder={ `{{resourceConfig.properties.placeholder}}` }
  {{#if resourceConfig.properties.showFilter}}
  showFilter={ {{resourceConfig.properties.showFilter}} }
  {{/if}}
  {{#if resourceConfig.properties.labelFilter}}
  labelFilter={ `{{resourceConfig.properties.labelFilter}}` }
  {{/if}}
  {{#if resourceConfig.properties.labelSearchFilter}}
  labelSearchFilter={ `{{resourceConfig.properties.labelSearchFilter}}` }
  {{/if}}
  {{#if (and resourceConfig.properties.disabled (not resourceConfig.data.disabled))}}
  disabled
  {{/if~}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if (and resourceConfig.properties.className parentResourceConfig)}}
  badgeClassName={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and resourceConfig.properties.className (not parentResourceConfig))}}
  badgeClassName={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties)}}
  badgeClassName={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
/>
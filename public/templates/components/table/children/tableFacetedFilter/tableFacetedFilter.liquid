<IGRPDataTableFilterFaceted
  column={column}
  placeholder={ `{{ resourceConfig.properties.placeholder }}` }
  {% if resourceConfig.properties.showFilter %}
  showFilter={ {{ resourceConfig.properties.showFilter }} }
  {% endif %}
  {% if resourceConfig.properties.labelFilter %}
  labelFilter={ `{{ resourceConfig.properties.labelFilter }}` }
  {% endif %}
  {% if resourceConfig.properties.labelSearchFilter %}
  labelSearchFilter={ `{{ resourceConfig.properties.labelSearchFilter }}` }
  {% endif %}
  {% if resourceConfig.properties.disabled and not resourceConfig.data.disabled %}
  disabled
  {% endif %}
  {% if resourceConfig.interactions %}
  {{ '' | render-interactions: resourceConfig.interactions }}
  {% endif %}
  {% if resourceConfig.data %}
  {{ '' | render-data: resourceConfig.data, resourceConfig }}
  {% endif %}
  {% if resourceConfig.properties.className and parentResourceConfig %}
  badgeClassName={ cn({{ '' | concat: "'", resourceConfig.properties.className, "',", '', '', '' }}) }
  {% else %}
  {% if resourceConfig.properties.className and not parentResourceConfig %}
  badgeClassName={ cn({{ '' | concat: "'", resourceConfig.properties.className, "',", '', '' }}) }
  {% else %}
  {% if resourceConfig.properties.className and parentResourceConfig.childProperties %}
  badgeClassName={ cn({{parentResourceConfig | addClassNameFromChildProperties: registry | concat: '', '' }}) }
  {% endif %}
  {% endif %}
  {% endif %}
/>
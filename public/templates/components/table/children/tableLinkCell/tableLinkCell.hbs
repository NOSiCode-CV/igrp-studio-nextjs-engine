return <IGRPDataTableCellLink
  href={ {{#if resourceConfig.data.value.code}}{{{resourceConfig.data.value.code}}}{{else}}row.getValue('{{resourceConfig.tag}}'){{/if}} }
  {{#if resourceConfig.properties.target}}target={ `{{resourceConfig.properties.target}}` }{{/if~}}
  {{#if resourceConfig.properties.color}}color={ `{{resourceConfig.properties.color}}` }{{/if~}}
  {{#if resourceConfig.properties.iconProperties.showIcon}}showIcon={ {{resourceConfig.properties.iconProperties.showIcon}} }{{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconName}}iconName={ `{{resourceConfig.properties.iconProperties.iconName}}` }{{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconSize}}iconSize={ `{{resourceConfig.properties.iconProperties.iconSize}}` }{{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconPlacement}}iconPlacement={ `{{resourceConfig.properties.iconProperties.iconPlacement}}` }{{/if~}}
  {{#if resourceConfig.properties.iconProperties.iconClassName}}iconClassName={ `{{resourceConfig.properties.iconProperties.iconClassName}}` }{{/if~}}
  {{#if resourceConfig.properties.variant}}variant={ `{{resourceConfig.properties.variant}}` }{{/if~}}
  children={
    <>
    {{#if resourceConfig.content}}
    {{resourceConfig.content}}
    {{else}}
    {{#if (and resourceConfig.properties.content (not resourceConfig.data.content))}}
    {{resourceConfig.properties.content}}
    {{else}}
    {{#if (and (not resourceConfig.properties.content) resourceConfig.data.content)}}
    { {{#if resourceConfig.data.content.value}}{{resourceConfig.data.content.value.code}}{{else}}{{resourceConfig.data.content.state.name}}{{/if}} }
    {{else}}
    {{#if resourceConfig.children}}
    {{#each resourceConfig.children}}
    {{{render-layout this ../resourceConfig}}}
    {{/each}}
    {{/if~}}
    {{/if~}}
    {{/if~}}
    {{/if~}}
    </>
  }
>
</IGRPDataTableCellLink>
<IGRPDataTableFilterMinMax
  column={column}
  {{#if resourceConfig.properties.placeholderMin}}
  placeholderMin={ `{{resourceConfig.properties.placeholderMin}}` }
  {{/if}}
  {{#if resourceConfig.properties.placeholderMax}}
  placeholderMax={ `{{resourceConfig.properties.placeholderMax}}` }
  {{/if}}
  {{#if resourceConfig.interactions}}
  {{{render-interactions resourceConfig.interactions}}}
  {{/if}}
  {{#if resourceConfig.data}}
  {{{render-data resourceConfig.data resourceConfig}}}
  {{/if}}
  {{#if (or (and resourceConfig.properties.className parentResourceConfig) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and resourceConfig.properties.className (not parentResourceConfig)) resourceConfig.style)}}
  className={ cn({{{concat "'" resourceConfig.properties.className "'," (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{else}}
  {{#if (or (and (nullOrEmpty resourceConfig.properties.className) parentResourceConfig.childProperties) resourceConfig.style)}}
  className={ cn({{{concat (addClassNameFromChildProperties parentResourceConfig registry) (addClassNameFromProperties resourceConfig registry) (addClassNameFromStyle resourceConfig.style)}}}) }
  {{/if~}}
  {{/if}}
  {{/if}}
/>
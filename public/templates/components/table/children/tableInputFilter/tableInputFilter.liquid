<IGRPDataTableFilterInput
  column={column}
  {% if resourceConfig.properties.placeholder %}
  placeholder={ `{{ resourceConfig.properties.placeholder }}` }
  {% endif %}
  {% if resourceConfig.properties.iconProperties.iconName %}
  iconName={ `{{ resourceConfig.properties.iconProperties.iconName }}` }
  {% endif %}
  {% if resourceConfig.interactions %}
  {{ '' | render-interactions: resourceConfig.interactions }}
  {% endif %}
  {% if resourceConfig.data %}
  {{ '' | render-data: resourceConfig.data, resourceConfig }}
  {% endif %}
  {% if resourceConfig.properties.className or parentResourceConfig and resourceConfig.style %}
  className={ cn({{ '' | concat: "'", resourceConfig.properties.className, "',", '', '', '' }}) }
  {% else %}
  {% if resourceConfig.properties.className and not parentResourceConfig or resourceConfig.style %}
  className={ cn({{ '' | concat: "'", resourceConfig.properties.className, "',", '', '' }}) }
  {% else %}
  {% if resourceConfig.properties.className and parentResourceConfig.childProperties or resourceConfig.style %}
  className={ cn({{parentResourceConfig | addClassNameFromChildProperties: registry | concat: '', '' }}) }
  {% endif %}
  {% endif %}
  {% endif %}
/>
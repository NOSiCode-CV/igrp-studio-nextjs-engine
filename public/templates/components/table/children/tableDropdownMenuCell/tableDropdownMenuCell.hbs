<IGRPDataTableDropdownMenu
  items={
    [
      {{#if resourceConfig.children}}
      {{#each resourceConfig.children}}
      {{{resolveRules this}}}{
        component: {{resolveComponent this.componentName ../registry}},
        props: {
          {{#if this.properties.title}}title: `{{this.properties.title}}`,{{/if~}}
          {{#if this.properties.modalTitle}}modalTitle: `{{this.properties.modalTitle}}`,{{/if~}}
          {{#if this.properties.labelTrigger}}labelTrigger: `{{this.properties.labelTrigger}}`,{{/if~}}
          {{#if this.properties.iconProperties.icon}}icon: `{{this.properties.iconProperties.icon}}`,{{/if~}}
          {{#if this.properties.iconProperties.iconName}}icon: `{{this.properties.iconProperties.iconName}}`,{{/if~}}
          {{#if this.properties.iconProperties.iconPlacement}}iconPlacement: `{{this.properties.iconProperties.iconPlacement}}`,{{/if~}}
          {{#if this.properties.iconProperties.iconClassName}}iconClassName: `{{this.properties.iconProperties.iconClassName}}`,{{/if~}}
          {{#if this.properties.variant}}variant: `{{this.properties.variant}}`,{{/if~}}
          {{#if this.properties.href}}href: `{{{resolve-segment-path this.properties.href this.properties.segments}}}{{#if this.properties.params}}{{{resolve-query-params this.properties.params}}}{{/if}}`,{{/if~}}
          {{#if this.properties.className}}className: `{{this.properties.className}}`,{{/if~}}
          {{!--{{#if this.properties.action}}action: () => {{this.properties.action}}(rowData),{{/if~}}--}}
          {{#if this.properties.iconProperties.showIcon}}showIcon: {{this.properties.iconProperties.showIcon}},{{/if~}}
          {{#if this.properties.showIcon}}showIcon: {{this.properties.showIcon}},{{/if~}}
          {{#if this.properties.showCancel}}showCancel: {{this.properties.showCancel}},{{/if~}}
          {{#if this.properties.labelCancel}}labelCancel: `{{this.properties.labelCancel}}`,{{/if~}}
          {{#if this.properties.classNameCancel}}classNameCancel: `{{this.properties.classNameCancel}}`,{{/if~}}
          {{#if this.properties.variantCancel}}variantCancel: `{{this.properties.variantCancel}}`,{{/if~}}
          {{#if this.properties.showConfirm}}showConfirm: {{this.properties.showConfirm}},{{/if~}}
          {{#if this.properties.labelConfirm}}labelConfirm: `{{this.properties.labelConfirm}}`,{{/if~}}
          {{#if this.properties.classNameConfirm}}classNameConfirm: `{{this.properties.classNameConfirm}}`,{{/if~}}
          {{#if this.properties.classNameItem}}classNameItem: `{{this.properties.classNameItem}}`,{{/if~}}
          {{#if this.properties.variantConfirm}}variantConfirm: `{{this.properties.variantConfirm}}`,{{/if~}}
          {{#if this.properties.actionConfirm}}onClickConfirm: () => {{this.properties.actionConfirm}}(rowData),{{/if~}}
          {{#if this.interactions}}
          {{{render-interactions this.interactions true}}}
          {{/if~}}
          {{#if this.children}}
          children:
          {{#each this.children}}
          {{{render-layout this ../resourceConfig}}}
          {{/each}}
          {{else}}
          {{#if this.properties.content}}
          children: <>{{this.properties.content}}</>
          {{/if}}
          {{/if~}}
        }
      },
      {{/each}}
      {{/if~}}
    ]
  }
>
</IGRPDataTableDropdownMenu>
'use client';

import React, { useEffect, useState } from 'react';
import Cookies from 'js-cookie';
import {SidebarProvider, CustomNavbar, CustomSidebar} from "@igrp/navbar-library"
import styles from './MainLayout.module.css';

import en from 'messages/en.json';
import pt from 'messages/pt.json';
import es from 'messages/es.json';

const getTranslations = (locale: string | undefined) => {
  switch (locale) {
    case 'pt':
      return pt;
    case 'es':
      return es;
    default:
      return en;
  }
};

interface MainLayoutProps {
  children: React.ReactNode;
}

const MainLayout: React.FC<MainLayoutProps> = ({ children }) => {
  const [isTokenChecked, setIsTokenChecked] = useState(false);

  useEffect(() => {
    const token = Cookies.get('userToken');
    
    if (!token) {
      const logoutUrl = 'https://frontend-dev-test.nosi.cv' + "/logout";
      window.location.href = logoutUrl;
    } else {
      setIsTokenChecked(true);
    }
  }, []);

  if (!isTokenChecked) {
    return null;
  }

  const currentLocale = Cookies.get('NEXT_LOCALE');
  const translations = getTranslations(currentLocale);

  return (
    <SidebarProvider>
      <>
        <CustomNavbar
          translations={ {
            RecentAppsDropdown: translations.RecentAppsDropdown,
            ProfileDropdown: translations.ProfileDropdown
          } }
          NEXT_PUBLIC_BASE_IGRP_UI_URL={'https://frontend-dev-test.nosi.cv'} 
          NEXT_PUBLIC_APP_MANAGER_API={'https://app-manager-dev-test.nosi.cv'} 
          NEXT_PUBLIC_USER_MANAGER_API={'https://user-manager-dev-test.nosi.cv'} 
        />
        <div className={`d-flex ${styles.container}`}>
          <CustomSidebar
            translations={ {
              Sidebar: translations.Sidebar,
            } }
            appId={'3'} 
            NEXT_PUBLIC_BASE_IGRP_UI_URL={'https://frontend-dev-test.nosi.cv'} 
            NEXT_PUBLIC_APP_MANAGER_API={'https://app-manager-dev-test.nosi.cv'}
          />
          <div className={`${styles.content}`}>
            {children} 
          </div>
        </div>
      </>
    </SidebarProvider>
  );
};

export default MainLayout;
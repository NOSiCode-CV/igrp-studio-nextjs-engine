'use client';

import React, { useEffect, useState } from 'react';
import Cookies from 'js-cookie';
import {SidebarProvider, CustomNavbar, CustomSidebar} from "@igrp/navbar-library"
import styles from './MainLayout.module.css';

interface MainLayoutProps {
  children: React.ReactNode;
}

const MainLayout: React.FC<MainLayoutProps> = ({ children }) => {
    const [isTokenChecked, setIsTokenChecked] = useState(false);

  useEffect(() => {
    const token = Cookies.get('userToken');
    
    if (!token) {
      const logoutUrl = process.env.NEXT_PUBLIC_BASE_IGRP_UI_URL + "/logout";
      window.location.href = logoutUrl;
    } else {
      setIsTokenChecked(true);
    }
  }, []);

  if (!isTokenChecked) {
    return null;
  }

  return (
    <SidebarProvider>
      <>
        <CustomNavbar 
          NEXT_PUBLIC_BASE_IGRP_UI_URL={process.env.NEXT_PUBLIC_BASE_IGRP_UI_URL || ''} 
          NEXT_PUBLIC_APP_MANAGER_API={process.env.NEXT_PUBLIC_APP_MANAGER_API || ''} 
          NEXT_PUBLIC_USER_MANAGER_API={process.env.NEXT_PUBLIC_USER_MANAGER_API || ''} 
        />
        <div className={`d-flex ${styles.container}`}>
          <CustomSidebar
            appId={process.env.NEXT_PUBLIC_APP_ID || ''} 
            NEXT_PUBLIC_BASE_IGRP_UI_URL={process.env.NEXT_PUBLIC_BASE_IGRP_UI_URL || ''} 
            NEXT_PUBLIC_APP_MANAGER_API={process.env.NEXT_PUBLIC_APP_MANAGER_API || ''}
          />
          <div className={`${styles.content}`}>
            {children} 
          </div>
        </div>
      </>
    </SidebarProvider>
  );
};

export default MainLayout;
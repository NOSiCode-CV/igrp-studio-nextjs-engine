
{{#if resourceConfig.components}}
import { IpageService } from '@/app/pages/{{toLowerCase resourceConfig.pageName}}/page'

{{#each resourceConfig.components }}
{{#each this.Row as |component index|}}
{{#each component.Col}}
const {{toLowerCase this.componentName}}{{index}}Action = () => {}
const {{toLowerCase this.componentName}}{{index}}Populate = () => {}

{{/each}}
{{/each}}
{{/each}}

export const {{capitalize resourceConfig.pageName}}Service: IpageService = {
  {{#each resourceConfig.components }}
  {{#each this.Row as |component index|}}
  {{#each component.Col}}
  {{toLowerCase this.componentName}}{{index}}: {
    action: {{toLowerCase this.componentName}}{{index}}Action,
    populate: {{toLowerCase this.componentName}}{{index}}Populate
  },{{#if @last}}{{else}},{{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
}
{{else}}
export const {{capitalize resourceConfig.pageName}}Service = () => {}
{{/if}}



    action: {{toLowerCase this.componentName}}{{@key}}Action,
    populate: {{toLowerCase this.componentName}}{{@key}}Populate
  }{{#if @last}}{{else}},{{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
}
{{else}}
export const {{capitalize resourceConfig.pageName}}Service = () => {}
{{/if}}



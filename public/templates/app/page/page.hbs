'use client'

import React from 'react'
import { Col, Row, Container } from 'reactstrap'
import { {{capitalize resourceConfig.pageName}}Service} from '@/services/{{toLowerCase resourceConfig.pageName}}/{{capitalize resourceConfig.pageName}}Service'

{{#if resourceConfig.components}}

{{#if  (gt (length velzonImports) 0)}}
import{
{{#each velzonImports}}
  {{this}}{{#if @last}}{{else}},{{/if}}
{{/each}}
}from 'nosi-velzon-ts'
{{/if}}

{{#each resourceConfig.components as |component index|}}
{{#each this.Row as |component index|}}
{{#each component.Col}}
export type {{capitalize this.componentName}}{{index}}Config = [
  {{#each this.fields}}
  {
    type: {{../this.componentName}}Fields,
    config:{{this.type}}Props,
  }{{#if @last}}{{else}},{{/if}} 
  {{/each}}
]
{{/each}}
{{/each}}
{{/each}}

{{/if}}

export type I{{toLowerCase resourceConfig.pageName}}Service = {
  {{#each resourceConfig.components as |component index|}}
  {{#each this.Row as |component index|}}
  {{#each component.Col}}
  {{toLowerCase this.componentName}}{{index}}: {
    action?: {{capitalize this.componentName}}ActionFunction,
    populate?: {{capitalize this.componentName}}PopulateFunction
  }{{#if @last}}{{else}},{{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
}



export default function {{resourceConfig.pageName}}() {
  {{#if resourceConfig.components}}
  const service: IpageService = {{capitalize resourceConfig.pageName}}Service;

  {{#each resourceConfig.components as |component index|}}
  {{#each this.Row as |component index|}}
  {{#each component.Col}}
  const {{toLowerCase this.componentName}}Fields{{index}}: {{capitalize this.componentName}}Props<{{capitalize this.componentName}}{{index}}Config> = {
    fields: [
      {{#each this.fields}}
      {{{json this}}}{{#if @last}}{{else}},{{/if}}
      {{/each}}
    ]
  };
  {{#each this.fields}}
  
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}

  return (
    <React.Fragment>
      <Container fluid>
        {{#each resourceConfig.components as |component index|}}
        <Row>
        {{#each this.Row as |component index|}}
          {{#each component.Col}}
          <Col xxl={ {{this.colSize}} }>
            <{{this.componentName}} 
              populate = {service.{{toLowerCase this.componentName}}{{index}}.populate}
              action = {service.{{toLowerCase this.componentName}}{{index}}.action}
              fields = { {{toLowerCase this.componentName}}Fields{{index}}.fields}
            />
          </Col>
          {{/each}}
        {{/each}}
        </Row>
        {{/each}}
      </Container>
    </React.Fragment>
  )
  {{else}}
    return null
  {{/if}}
}

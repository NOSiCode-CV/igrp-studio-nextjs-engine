'use client'

{{#if resourceConfig.components}}
import * as yup from 'yup';
{{else}}
import 'bootstrap/dist/css/bootstrap.min.css';
{{/if}}
import React, { useRef } from 'react'
import { Col, Row, Container } from 'reactstrap'
import { {{capitalize resourceConfig.pageName}}Service} from '@/services/{{toLowerCase resourceConfig.pageName}}/{{capitalize resourceConfig.pageName}}Service'

{{#if resourceConfig.components}}

{{#if  (gt (length velzonImports) 0)}}
import{ {{#each velzonImports}}IGRP_{{this}}{{#if @last}}{{else}},
{{/if}}
{{/each}}
}from '@igrp/nosi-velzon-ts'
{{/if}}

{{#each resourceConfig.components}}
{{#each Row}}
{{#each Col }}
{{#each components}}
type I{{capitalize this.id}}Fields = { {{#if (eq this.componentName 'FormLayout')}}{{#each this.fields}}
  {{this.config.name}}: IGRP_{{../this.componentName}}.Field.{{this.type}}{{#if @last}}{{else}},{{/if}}{{/each}}
  {{/if}}
}
{{/each}}
{{/each}}
{{/each}}
{{/each}}

{{/if}}
export type I{{toLowerCase resourceConfig.pageName}}Service = {
  {{#each resourceConfig.components}}
  {{#each Row }}
  {{#each Col}}
  {{#each components}} 
  {{#if (eq this.componentName 'Button')}}
  {{this.id}}: (data?: Record<string, unknown>) => void;
  {{else}}
  {{toLowerCase this.id}}: IGRP_{{this.componentName}}.Props<I{{capitalize this.id}}Fields>['service']{{#if @last}}{{else}},{{/if}}
  {{!-- Declaring button action inside table --}}
  {{#if (eq this.componentName 'TableComponent')}}
  {{#if this.actions}}
  {{#each this.actions}}
  {{this.id}}: ((data?: Record<string, any>) => void);
  {{/each}}
  {{/if}}
  {{/if}}
  {{!-- End declare button action inside table --}} 
  {{/if}}
  {{!-- Declaring button action inside form --}}
  {{#if (eq this.componentName 'FormLayout')}}
  {{#each this.fields}}
  {{#if (eq this.type 'IGRP_ButtonInput')}}
  {{this.config.name}}:(data: Record<string, unknown>) => void;
  {{/if}}{{/each}}
  {{/if}}
  {{!-- End declare button action inside form --}}  
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}
}

export default function {{resourceConfig.pageName}}() {
  {{#if resourceConfig.components}}
  const service: I{{toLowerCase resourceConfig.pageName}}Service = {{capitalize resourceConfig.pageName}}Service;
  {{!-- Declaring form references --}}
  {{#each resourceConfig.components}}
  {{#each Row}}
  {{#each Col}}
  {{#each components}}
  {{#if (eq this.componentName 'FormLayout')}}
  const {{this.id}}Ref = useRef<IGRP_FormLayout.FormLayoutRef>(null) {{/if}}
  {{/each}}{{!-- end each components --}}
  {{/each}} {{!-- end each Col --}}
  {{/each}} {{!-- end each Row --}}
  {{/each}} {{!-- end each resourcesConfig.components --}}
  {{!-- end declaring form refences --}}

  {{#each resourceConfig.components}}
  {{#each Row}}
  {{#each Col}}
  {{#each components}}
  const {{capitalize this.id}}Props: IGRP_{{this.componentName}}.Props<{{component-name-helper this}}> = {
  {{#if (eq this.componentName 'Button')}}{{#if  (gt (length ../../../../formRefs) 0)}}
    formRefs: {
      {{#each ../../../../formRefs}}
      {{this}}: {{this}}Ref,
      {{/each}}
    },{{/if}}
    serviceAction: service.{{this.id}},
    config: {{{json this.config}}},
  {{else}}
    service: service?.{{toLowerCase this.id}},
    fields: {{{field-helper this}}},
    config: {{{json this.config}}}{{#if this.actions}},
    actions: (cell: any) => {
      return (
        <React.Fragment>
          {{#each this.actions}}
          <IGRP_Button
            values={cell.row.original}
            serviceAction={service.{{this.id}} }           
            config={ 
              {{{json this.config}}} 
            }
            />
          {{/each}}
        </React.Fragment>
      )
    }
    {{/if}} {{/if}}  
  }
  {{#each this.fields }}
  {{#if (eq ../componentName 'FormLayout')}}{{#if  (isValidation this)}} {{!-- check validation fields --}}
  {{capitalize ../id}}Props.fields.{{this.config.name}}.validation = {{{yup-validation this}}}{{/if}}{{!-- end check validation fields --}}
  {{#if (eq this.type 'IGRP_ButtonInput')}}{{!-- set formRef and serviceAction to the button field --}}
  {{capitalize ../id}}Props.fields.{{this.config.name}}.config.formRefs = { {{../id}}: {{../id}}Ref };
  {{capitalize ../id}}Props.fields.{{this.config.name}}.config.serviceAction =service.{{this.config.name}};
  {{/if}}{{!-- end set formRef and serviceAction to the button field --}}
  {{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}

  return (
    <React.Fragment>
      <Container fluid>
        {{#each resourceConfig.components}}
        <Row>
        {{#each Row}}
        {{#each Col}}
          <Col lg={ {{this.colSize}} }>
          {{#each components}}
            {{#if (eq this.componentName 'Button')}}
            <IGRP_{{this.componentName}} {...{{capitalize this.id}}Props} />
            {{else}}
            <IGRP_{{this.componentName}}.{{this.componentName}} {...{{capitalize this.id}}Props} {{#if (eq this.componentName 'FormLayout')}}ref={ {{this.id}}Ref }{{/if}}/>
            {{/if}}
          {{/each}}
          </Col>
          {{/each}}
        {{/each}}
        </Row>
        {{/each}}
      </Container>
    </React.Fragment>
  )
  {{else}}
  return (
    <Container fluid className="d-flex vh-100">
      <Row className="justify-content-center align-items-center w-100">
        <Col xl={12} className="d-flex justify-content-center">
          <p className="text-center" style={ { fontSize: 35 } }>
            Your components will be displayed here
          </p>
        </Col>
      </Row>
    </Container>
  )
  {{/if}}
}

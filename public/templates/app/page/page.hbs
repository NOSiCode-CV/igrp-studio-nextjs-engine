'use client'

import React from 'react'
import { Col, Row, Container } from 'reactstrap'
import { {{capitalize resourceConfig.pageName}}Service} from '@/services/{{toLowerCase resourceConfig.pageName}}/{{capitalize resourceConfig.pageName}}Service'

{{#if resourceConfig.components}}
{{#each resourceConfig.components}}
import {
{{#each this.Row}}
{{#each this.Col}}
 {{this.componentName}}{{#if @last}}{{else}},{{/if}} 
{{/each}}
{{/each}}
} from 'nosi-velzon-ts'
{{/each}}

{{#each resourceConfig.components}}
{{#each this.Row}}
{{#each this.Col}}
export type {{capitalize this.componentName}}{{@key}}Config = [
  {{#each this.fields}}
  {
    type: {{../this.componentName}}Fields,
    config:{{../this.componentName}}FieldsProps,
  }{{#if @last}}{{else}},{{/if}} 
  {{/each}}
]
{{/each}}
{{/each}}
{{/each}}

export type IpageService = {
  {{#each resourceConfig.components}}
  {{#each this.Row}}
  {{#each this.Col}}
  {{toLowerCase this.componentName}}{{@key}}: {
    action?: {{capitalize this.componentName}}ActionFunction,
    populate?: {{capitalize this.componentName}}PopulateFunction
  }{{#if @last}}{{else}},{{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
}
{{/if}}


export default function {{resourceConfig.pageName}}() {
  {{#if resourceConfig.components}}
  const service: IpageService = {{capitalize resourceConfig.pageName}}Service;

  {{#each resourceConfig.components}}
  {{#each this.Row}}
  {{#each this.Col}}
  const {{toLowerCase this.componentName}}Fields: {{capitalize this.componentName}}Props<{{capitalize this.componentName}}{{@key}}Config> = {
    fields: [
      {{#each this.fields}}
      {{{json this}}}{{#if @last}}{{else}},{{/if}}
      {{/each}}
    ]
  };
  {{#each this.fields}}
  
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}

  return (
    <React.Fragment>
      <Container fluid>
        <Row>
          {{#each resourceConfig.components}}
          {{#each this.Row}}
          {{#each this.Col}}
          <Col xxl={ {{this.colSize}} }>
            <{{this.componentName}} 
              populate = {service.{{toLowerCase this.componentName}}{{@key}}.populate}
              action = {service.{{toLowerCase this.componentName}}{{@key}}.action}
              fields = { {{toLowerCase this.componentName}}Fields.fields}
            />
          </Col>
          {{/each}}
          {{/each}}
          {{/each}}
        </Row>
      </Container>
    </React.Fragment>
  )
  {{else}}
    return null
  {{/if}}
}

'use client'

{{#if resourceConfig.components}}
{{else}}
import 'bootstrap/dist/css/bootstrap.min.css';
{{/if}}
import React from 'react'
import { Col, Row, Container } from 'reactstrap'
import { {{capitalize resourceConfig.pageName}}Service} from '@/services/{{toLowerCase resourceConfig.pageName}}/{{capitalize resourceConfig.pageName}}Service'

{{#if resourceConfig.components}}

{{#if  (gt (length velzonImports) 0)}}
import{
{{#each velzonImports}}
  {{this}}{{#if @last}}{{else}},{{/if}}
{{/each}}
}from '@igrp/nosi-velzon-ts'
{{/if}}

{{#each resourceConfig.components}}
{{#each Row}}
{{#each Col }}
{{#each components}}
type I{{capitalize this.id}}Fields = {
  {{#each this.fields}}
  {{this.config.name}}: {{../this.componentName}}.Field.{{this.type}}{{#if @last}}{{else}},{{/if}} 
  {{/each}}
}
{{/each}}
{{/each}}
{{/each}}
{{/each}}

{{/if}}
export type I{{toLowerCase resourceConfig.pageName}}Service = {
  {{#each resourceConfig.components}}
  {{#each Row }}
  {{#each Col}}
  {{#each components}}
  {{toLowerCase this.id}}: {{this.componentName}}.Props<I{{capitalize this.id}}Fields>['service']{{#if @last}}{{else}},{{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}
}

export default function {{resourceConfig.pageName}}() {
  {{#if resourceConfig.components}}
  const service: I{{toLowerCase resourceConfig.pageName}}Service = {{capitalize resourceConfig.pageName}}Service;

  {{#each resourceConfig.components}}
  {{#each Row}}
  {{#each Col}}
  {{#each components}}
  const {{capitalize this.id}}Props: {{this.componentName}}.Props<I{{capitalize this.id}}Fields> = {
    service: service?.{{toLowerCase this.id}},
    fields: {
      {{#each this.fields}}
      {{this.config.name}}: {{{json this}}}{{#if @last}}{{else}},{{/if}}
      {{/each}}
    },
    config: {{{json this.config}}}
  };
  {{#each this.fields}}
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}


  return (
    <React.Fragment>
      <Container fluid>
        {{#each resourceConfig.components}}
        <Row>
        {{#each Row}}
          {{#each Col}}
          {{#each components}}
          <Col lg={ {{this.config.colSize}} }>
            <{{this.componentName}}.{{this.componentName}} {...{{capitalize this.id}}Props}/>
          </Col>
          {{/each}}
          {{/each}}
        {{/each}}
        </Row>
        {{/each}}
      </Container>
    </React.Fragment>
  )
  {{else}}
  return (
    <Container fluid className="d-flex vh-100">
      <Row className="justify-content-center align-items-center w-100">
        <Col xl={12} className="d-flex justify-content-center">
          <p className="text-center" style={ { fontSize: 35 } }>
            Your components will be displayed here
          </p>
        </Col>
      </Row>
    </Container>
  )
  {{/if}}
}

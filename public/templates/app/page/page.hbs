'use client'

import React from 'react'
import { Col, Row, Container } from 'reactstrap'
import { {{capitalize resourceConfig.pageName}}Service} from '@/services/{{toLowerCase resourceConfig.pageName}}/{{capitalize resourceConfig.pageName}}Service'

{{#if resourceConfig.components}}

{{#if  (gt (length velzonImports) 0)}}
import{
{{#each velzonImports}}
  {{this}}{{#if @last}}{{else}},{{/if}}
{{/each}}
}from '@igrp/nosi-velzon-ts'
{{/if}}

{{#each resourceConfig.components as |component index|}}
{{#each component.Row}}
{{#each this.Col}}
type I{{capitalize this.componentName}}{{@index}}Fields = {
  {{#each this.fields}}
  {{this.config.name}}: {{../this.componentName}}.Field.{{this.type}}{{#if @last}}{{else}},{{/if}} 
  {{/each}}
}
{{/each}}
{{/each}}
{{/each}}

{{/if}}
export type I{{toLowerCase resourceConfig.pageName}}Service = {
  {{#each resourceConfig.components as |component index|}}
  {{#each component.Row}}
  {{#each this.Col}}
  form{{@index}}: {{this.componentName}}.Props<I{{capitalize this.componentName}}{{@index}}Fields>['service']{{#if @last}}{{else}},{{/if}}
  {{/each}}
  {{/each}}
  {{/each}}
}

export default function {{resourceConfig.pageName}}() {
  {{#if resourceConfig.components}}
  const service: I{{toLowerCase resourceConfig.pageName}}Service = {{capitalize resourceConfig.pageName}}Service;

  {{#each resourceConfig.components as |component index|}}
  {{#each component.Row}}
  {{#each this.Col}}
  const Form{{index}}Props: {{capitalize this.componentName}}.Props<I{{capitalize this.componentName}}{{index}}Fields> = {
    service: service?.form{{@index}},
    fields: {
      {{#each this.fields}}
      {{this.config.name}}: {{{json this}}}{{#if @last}}{{else}},{{/if}}
      {{/each}}
    },
    config: {{{json this.config}}}
  };
  {{#each this.fields}}
  {{/each}}
  {{/each}}
  {{/each}}
  {{/each}}


  return (
    <React.Fragment>
      <Container fluid>
        {{#each resourceConfig.components as |component index|}}
        <Row>
        {{#each component.Row }}
          {{#each this.Col}}
          <Col xxl={ {{this.config.colSize}} }>
            <{{this.componentName}}.{{this.componentName}} {...Form{{@index}}Props}/>
          </Col>
          {{/each}}
        {{/each}}
        </Row>
        {{/each}}
      </Container>
    </React.Fragment>
  )
  {{else}}
    return null
  {{/if}}
}

'use client'

import React from 'react'
import { Col, Row, Container } from 'reactstrap'

{{#each resourceConfig.components}}
{{#each this.Row}}
{{#each this.Col}}
import { {{this.componentName}} } from '@/static/components/{{this.componentName}}/{{this.componentName}}'
{{/each}}
{{/each}}
{{/each}}

export default function {{resourceConfig.pageName}}(props: any) {
  {{#if resourceConfig.components}}

  return (
    <React.Fragment>
      <Container fluid>
        <Row>
          {{#each resourceConfig.components}}
          {{#each this.Row}}
          {{#each this.Col}}
          <Col xxl={ {{this.colSize}} }>
            <{{this.componentName}} 
              fields={
                {{#if (gt (length this.fields) 1)}}
                [
                  {{#each this.fields}}
                  {{{json this.config}}}{{#if @last}}{{else}},{{/if}}
                  {{/each}}
                ]
                {{else}}
                {{{json this.fields.[0].config}}}
                {{/if}}
              }
            />
          </Col>
          {{/each}}
          {{/each}}
          {{/each}}
        </Row>
      </Container>
    </React.Fragment>
  )
  {{else}}
    return null
  {{/if}}
}

# PostgreSQL Database
igrp_access_management_db:
  image: postgres:16-alpine
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-am-db
  hostname: ${IGRP_ACCESS_MANAGEMENT_DB_HOSTNAME}
  volumes:
    - {% if resourceConfig.platform.dataSource.volumes %}{{ resourceConfig.platform.dataSource.volumes.name }}{% else %}igrp_access_management_data{% endif %}:{% if resourceConfig.platform.dataSource.volumes %}{% if resourceConfig.platform.dataSource.volumes.path %}{{ resourceConfig.platform.dataSource.volumes.path }}{% else %}/var/lib/postgresql/data2{% endif %}{% else %}/var/lib/postgresql/data2{% endif %}
  restart: always
  shm_size: 128mb
  ports:
    - "{{ resourceConfig.platform.dataSource.ports.external }}:{{ resourceConfig.platform.dataSource.ports.internal }}"
  environment:
    POSTGRES_DB: ${IGRP_ACCESS_MANAGEMENT_DB_NAME}
    POSTGRES_USER: ${IGRP_ACCESS_MANAGEMENT_DB_USER}
    POSTGRES_PASSWORD: ${IGRP_ACCESS_MANAGEMENT_DB_PASSWORD}
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  labels:
    type: database

igrp_iam_db:
  image: postgres:16-alpine
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-iam-db
  hostname: ${IGRP_IAM_DB_HOSTNAME}
  volumes:
    - {% if resourceConfig.platform.auth.dataSource.volumes %}{{ resourceConfig.platform.auth.dataSource.volumes.name }}{% else %}igrp_iam_data{% endif %}:{% if resourceConfig.platform.auth.dataSource.volumes %}{% if resourceConfig.platform.auth.dataSource.volumes.path %}{{ resourceConfig.platform.auth.dataSource.volumes.path }}{% else %}/var/lib/postgresql/data2{% endif %}{% else %}/var/lib/postgresql/data2{% endif %}
  restart: always
  shm_size: 128mb
  ports:
    - "{{ resourceConfig.platform.auth.dataSource.ports.external }}:{{ resourceConfig.platform.auth.dataSource.ports.internal }}"
  environment:
    POSTGRES_DB: ${IGRP_IAM_DB_NAME}
    POSTGRES_USER: ${IGRP_IAM_DB_USER}
    POSTGRES_PASSWORD: ${IGRP_IAM_DB_PASSWORD}
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  labels:
    type: database

# Keycloak server
igrp_keycloak:
  image: keycloak/keycloak:25.0.4
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-keycloak
  hostname: ${IGRP_IAM_HOSTNAME}
  command:
    - start
    - --import-realm
    - --features=admin-fine-grained-authz
  volumes:
    - {% if resourceConfig.platform.auth.volumes %}{{ resourceConfig.platform.auth.volumes.name }}{% else %}./data/{% endif %}:{% if resourceConfig.platform.auth.volumes %}{% if resourceConfig.platform.auth.volumes.path %}{{ resourceConfig.platform.auth.volumes.path }}{% else %}/opt/keycloak/data/import{% endif %}{% else %}/opt/keycloak/data/import{% endif %}
  ports:
    - "{{ resourceConfig.platform.auth.ports.external }}:{{ resourceConfig.platform.auth.ports.internal }}"
  restart: always
  extra_hosts:
    - "${IGRP_IAM_HOSTNAME}:host-gateway"
  depends_on:
    - igrp_iam_db
  env_file:
    - .igrp.env
    - .iam.igrp.env
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  healthcheck:
    test: [
      "CMD-SHELL",
      'exec 3<>/dev/tcp/localhost/{{ resourceConfig.platform.auth.ports.internal }}; echo -e "GET /health/ready HTTP/1.1\nhost: localhost:{{ resourceConfig.platform.auth.ports.internal }}\n" >&3; timeout --preserve-status 1 cat <&3 | grep -m 1 status | grep -m 1 UP; ERROR=$$?; exec 3<&-; exec 3>&-; exit $$ERROR'
    ]
    interval: 10s
    timeout: 5s
    retries: 5
  labels:
    type: auth

# Minio server
minio:
  image: minio/minio:latest
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-minio
  restart: no
  env_file:
    - .igrp.env
    - .file.igrp.env
  volumes:
    - {% if resourceConfig.platform.file.volumes %}{{ resourceConfig.platform.file.volumes.name }}{% else %}./data{% endif %}:{% if resourceConfig.platform.file.volumes %}{% if resourceConfig.platform.file.volumes.path %}{{ resourceConfig.platform.file.volumes.path }}{% else %}/minio_data{% endif %}{% else %}/minio_data{% endif %}
  ports:
    {% for this in resourceConfig.platform.file.ports %}
    - "{{ this.external }}:{{ this.internal }}"
    {% endfor %}
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  command: server /data --console-address :{{ '' | getAttribute: resourceConfig.platform.file.ports, 1, 'internal' }}
  entrypoint: >
    /bin/sh -c '
      isAlive() { curl -sf http://127.0.0.1:{{ '' | getAttribute: resourceConfig.platform.file.ports, 0, 'internal' }}/minio/health/live; }    # check if Minio is alive
      minio $0 "$@" --quiet & echo $! > /tmp/minio.pid                   # start Minio in the background
      while ! isAlive; do sleep 0.1; done                                # wait until Minio is alive
      mc alias set minio http://127.0.0.1:{{ '' | getAttribute: resourceConfig.platform.file.ports, 0, 'internal' }} ${IGRP_FILE_MANAGEMENT_USER} ${IGRP_FILE_MANAGEMENT_PASSWORD} # setup Minio client
      mc mb minio/${IGRP_FILE_MANAGEMENT_STORAGE_NAME}|| true                            # create a test bucket
      mc anonymous set public minio/${IGRP_FILE_MANAGEMENT_STORAGE_NAME}                 # make the test bucket public
      kill -s INT $(cat /tmp/minio.pid) && rm /tmp/minio.pid             # stop Minio
      while isAlive; do sleep 0.1; done                                  # wait until Minio is stopped
      exec minio $0 "$@"                                                 # start Minio in the foreground
    '
  labels:
    type: file

# User management API
igrp-user-management-api:
  image: registry.nosi.cv/formacao-igrp/igrp-user-management-api:demo-local
  depends_on:
    igrp_keycloak:
      condition: service_healthy
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-user-management
  env_file:
    - .um.igrp.env
  ports:
    - "{{ resourceConfig.platform.userManager.ports.external }}:{{ resourceConfig.platform.userManager.ports.internal }}"
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  labels:
    type: web

# App Management API
igrp-app-manager-api:
  image: registry.nosi.cv/formacao-igrp/app-manager-api:demo-local
  env_file:
    - .am.igrp.env
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-app-manager
  ports:
    - "{{ resourceConfig.platform.appManager.ports.external }}:{{ resourceConfig.platform.appManager.ports.internal }}"
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  depends_on:
    igrp_keycloak:
      condition: service_healthy
  labels:
    type: web

# IGRP UI
igrp-ui:
  image: registry.nosi.cv/formacao-igrp/igrp-ui-dev:demo-local
  env_file:
    - .igrp.env
    - .ui.igrp.env
  container_name: {{ '' | toLowerCase: resourceConfig.workspace }}-igrp-ui
  ports:
    - "{{ resourceConfig.platform.ui.ports.external }}:{{ resourceConfig.platform.ui.ports.internal }}"
  networks:
    - {{ '' | toLowerCase: resourceConfig.workspace }}-network
  depends_on:
    - igrp-app-manager-api
    - igrp-user-management-api
  stdin_open: true
  labels:
    type: web

# PostgreSQL Database
  igrp_access_management_db:
    image: postgres:16-alpine
    container_name: ${POSTGRES_HOSTNAME}
    hostname: ${POSTGRES_HOSTNAME}
    volumes:
      - igrp_access_management_data:/var/lib/postgresql/data2
    restart: always
    shm_size: 128mb
    ports:
      - 5432:5432
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    networks:
      - {{toLowerCase resourceConfig.workspace}}-network
    env_file: ".igrp.env"

  # Keycloak server
  keycloak:
    image: keycloak/keycloak:25.0.4
    container_name: {{toLowerCase resourceConfig.workspace}}-keycloak
    hostname: ${KEYCLOAK_HOSTNAME}
    command:
      - start
      - --import-realm
      - --features=admin-fine-grained-authz
    environment:
      KC_HOSTNAME: http://${KEYCLOAK_HOSTNAME}:${KEYCLOAK_HOSTNAME_PORT}
      KC_HOSTNAME_PORT: ${KEYCLOAK_HOSTNAME_PORT}
      KC_HOSTNAME_STRICT_BACKCHANNEL: false
      KC_HTTP_ENABLED: true
      KC_HOSTNAME_STRICT_HTTPS: false
      KC_HEALTH_ENABLED: true
      KEYCLOAK_ADMIN: ${KEYCLOAK_ADMIN}
      KEYCLOAK_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}
      KC_HOSTNAME_BACKCHANNEL_DYNAMIC: true
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://igrp_access_management_db:5432/${POSTGRES_DB} {{!-- TODO: change database to auth specific database (do not share with platform's) --}}
      KC_DB_USERNAME: ${POSTGRES_USER}
      KC_DB_PASSWORD: ${POSTGRES_PASSWORD}
      KEYCLOAK_IMPORT: ./igrp-user-management-api/igrp-user-management-api/imports/${KEYCLOAK_REALM}-realm.json
    volumes:
      - ./data/:/opt/keycloak/data/import
    ports:
      - ${KEYCLOAK_HOSTNAME_PORT}:${KEYCLOAK_HOSTNAME_PORT}
    restart: always
    extra_hosts:
      - "${KEYCLOAK_HOSTNAME}:host-gateway"
    depends_on:
      - igrp_access_management_db
    env_file: ".igrp.env"
    networks:
      - {{toLowerCase resourceConfig.workspace}}-network
    healthcheck:
      test:   [
          "CMD-SHELL",
          'exec 3<>/dev/tcp/localhost/8080; echo -e "GET /health/ready HTTP/1.1\nhost: localhost:8080\n" >&3; timeout --preserve-status 1 cat <&3 | grep -m 1 status | grep -m 1 UP; ERROR=$?; exec 3<&-; exec 3>&-; exit $ERROR'
       ]
      interval: 10s
      timeout: 5s
      retries: 5

  # Minio server
  minio:
    image: minio/minio:latest
    container_name: {{toLowerCase resourceConfig.workspace}}-minio
    restart: no
    env_file: ".igrp.env"
    environment:
      MINIO_ROOT_USER: ${MINIO_ACCESS_KEY}
      MINIO_ROOT_PASSWORD: ${MINIO_SECRET_KEY}
    volumes:
      - ./data:/minio_data
    ports:
      - "9000:9000"
      - "9001:9001"
    networks:
      - {{toLowerCase resourceConfig.workspace}}-network
    command: server /data --console-address :9001
    entrypoint: >
      /bin/sh -c '
        isAlive() { curl -sf http://127.0.0.1:9000/minio/health/live; }    # check if Minio is alive
        minio $0 "$@" --quiet & echo $! > /tmp/minio.pid                   # start Minio in the background
        while ! isAlive; do sleep 0.1; done                                # wait until Minio is alive
        mc alias set minio http://127.0.0.1:9000 ${MINIO_ACCESS_KEY} ${MINIO_SECRET_KEY} # setup Minio client
        mc mb minio/${MINIO_BUCKET_NAME}|| true                            # create a test bucket
        mc anonymous set public minio/${MINIO_BUCKET_NAME}                 # make the test bucket public
        kill -s INT $(cat /tmp/minio.pid) && rm /tmp/minio.pid             # stop Minio
        while isAlive; do sleep 0.1; done                                  # wait until Minio is stopped
        exec minio $0 "$@"                                                 # start Minio in the foreground
      '

  # User management API
  user-management-api:
    image: registry.nosi.cv/formacao-igrp/igrp-user-management-api:demo-local
    depends_on:
      keycloak:
        condition: service_healthy
    container_name: {{toLowerCase resourceConfig.workspace}}-user-management
    env_file: ".um.igrp.env"
    ports:
      - "8081:8081"
    networks:
      - {{toLowerCase resourceConfig.workspace}}-network

  # App Management API
  app-manager-api:
    image: registry.nosi.cv/formacao-igrp/app-manager-api:demo-local
    env_file: ".am.igrp.env"
    container_name: {{toLowerCase resourceConfig.workspace}}-app-manager
    ports:
      - "8082:8082"
    networks:
      - {{toLowerCase resourceConfig.workspace}}-network
    depends_on:
      keycloak:
        condition: service_healthy

  # IGRP UI
  igrp-ui:
    image: registry.nosi.cv/formacao-igrp/igrp-ui-dev:demo-local
    env_file: ".igrp.env"
    container_name: {{toLowerCase resourceConfig.workspace}}-igrp-ui
    ports:
      - "3000:3000"
    networks:
      - {{toLowerCase resourceConfig.workspace}}-network
    depends_on:
      - app-manager-api
      - user-management-api
    stdin_open: true
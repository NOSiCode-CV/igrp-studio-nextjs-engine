#!/bin/sh
set -e

# Function to check if Minio is alive
isAlive() {
  curl -sf http://127.0.0.1:9000/minio/health/live > /dev/null
}

# Start Minio in background
minio "$@" &
MINIO_PID=$!

# Wait for minio to be ready (timeout 30s)
TIMEOUT=30
COUNTER=0
until isAlive; do
  sleep 1
  COUNTER=$((COUNTER + 1))
  if [ "$COUNTER" -ge "$TIMEOUT" ]; then
    kill -s TERM "$MINIO_PID"
    exit 1
  fi
done

# Configure MinIO with mc
mc alias set minio http://127.0.0.1:9000 "$IGRP_FILE_MANAGEMENT_USER" "$IGRP_FILE_MANAGEMENT_PASSWORD"
if ! mc ls minio/"$IGRP_FILE_MANAGEMENT_STORAGE_NAME" >/dev/null 2>&1; then
  mc mb minio/"$IGRP_FILE_MANAGEMENT_STORAGE_NAME"
fi
mc anonymous set public minio/"$IGRP_FILE_MANAGEMENT_STORAGE_NAME"

# Stops background process and start MinIO main process
kill -s INT "$MINIO_PID"
wait "$MINIO_PID"

exec minio "$@"
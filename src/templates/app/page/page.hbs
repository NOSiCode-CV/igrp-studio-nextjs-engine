'use client'

import React from 'react'
import { Col, Row, Container } from 'reactstrap'

{{#each resourceConfig.components}}
  {{#each this.Row}}
    {{#each this.Col}}
      import { {{this.componentName}} } from '@/static/components/{{this.componentName}}'
    {{/each}}
  {{/each}}
{{/each}}

export default function {{resourceConfig.pageName}}(props: any) {
  {{#if resourceConfig.components}}

  return (
    <React.Fragment>
      <Container fluid>
        <Row>
          {{#each resourceConfig.components}}
          {{#each this.Row}}
          {{#each this.Col}}
          <Col xxl={ {{this.colSize}} }>
            <{{this.componentName}} config={[
              {{#each this.fields}}
              {{{json this.config}}}{{#if @last}}{{else}},{{/if}}
              {{/each}}
              
            ]}btnConfig="{{this.submitBtnText}}"/>
          </Col>
          {{/each}}
          {{/each}}
          {{/each}}
        </Row>
      </Container>
    </React.Fragment>
  )
  {{else}}
    return null
  {{/if}}
}
